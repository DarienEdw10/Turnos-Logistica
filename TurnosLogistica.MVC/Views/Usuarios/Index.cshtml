@inject TurnosLogistica.Domain.Data.AppDbContext DbContext
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Gestión de Colaboradores y Permisos";
    
    // Obtener identidad actual para consultar el nivel real de forma segura y directa
    string rawIdentity = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                      ?? User.FindFirst("CWID")?.Value
                      ?? User?.Identity?.Name
                      ?? Environment.UserName;

    string cwid = rawIdentity.Contains('\\') ? rawIdentity.Split('\\')[1].Trim() : rawIdentity.Trim();
    string cwidUpper = cwid.ToUpperInvariant();

    var usuarioActualDb = DbContext.Usuarios
        .AsNoTracking()
        .FirstOrDefault(x => (x.CWID != null && x.CWID.ToUpper() == cwidUpper) || x.NoEmpleado == cwid);

    int nivelReal = usuarioActualDb?.Nivel ?? 10;
    string rolReal = usuarioActualDb?.Rol?.ToLower() ?? "operador";
    bool esSistemasReal = (rolReal == "sistemas" || nivelReal >= 40 || (ViewBag.EsSistemas ?? false));

    bool soloLectura = ViewBag.SoloLectura ?? false;
    int plantaActivaId = ViewBag.PlantaActivaId ?? 1;
    int plantaAsignadaId = ViewBag.PlantaAsignadaId ?? 1;
}

<style>
    .usuarios-container {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 20px;
        align-items: start;
    }
    .panel-dark-header {
        background: #1e293b;
        color: #f8fafc;
        border-radius: 10px 10px 0 0;
        padding: 12px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        font-size: 14px;
    }
    .panel-blue-header {
        background: #2563eb;
        color: #ffffff;
        border-radius: 10px 10px 0 0;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 14px;
    }
    .search-bar-wrap {
        padding: 14px 16px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 8px;
    }
    .tbl-scroll-wrap {
        max-height: 440px;
        overflow-y: auto;
        background: #fff;
        border-radius: 0 0 10px 10px;
        border: 1px solid var(--border);
        border-top: none;
    }
    .table-padron {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .table-padron th {
        position: sticky;
        top: 0;
        background: #f8fafc;
        padding: 10px 12px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        border-bottom: 1px solid var(--border);
        z-index: 10;
    }
    .table-padron td {
        padding: 10px 12px;
        border-bottom: 1px solid #f1f5f9;
    }
    .table-padron tr.row-empleado {
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .table-padron tr.row-empleado:hover {
        background: #f0f7ff;
    }
    .table-padron tr.row-empleado.selected {
        background: #e0e7ff !important;
    }
    .badge-cwid {
        background: #64748b;
        color: #fff;
        font-family: monospace;
        font-size: 11px;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 600;
    }
    .right-card-body {
        background: #fff;
        border: 1px solid var(--border);
        border-top: none;
        border-radius: 0 0 10px 10px;
        padding: 24px;
    }
    .btn-guardar-permiso {
        background: #10b981;
        color: #fff;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        width: 100%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.2s;
    }
    .btn-guardar-permiso:hover:not(:disabled) {
        background: #059669;
    }
    .btn-guardar-permiso:disabled {
        background: #94a3b8 !important;
        cursor: not-allowed;
        opacity: 0.65;
    }
</style>

<div class="page-header" style="margin-bottom: 16px;">
    <div>
        <div class="page-title" style="font-size:20px; font-weight:700;">Gestión de Colaboradores y Permisos</div>
        <div class="page-subtitle" style="color:var(--text-muted); font-size:14px;">
            Asignación de roles en plataforma — Planta Activa: <strong>Planta @plantaActivaId</strong>
        </div>
    </div>
</div>

@if (soloLectura)
{
    <div class="notice notice-warn" style="display:flex; align-items:center; gap:10px; padding:12px 16px; border-radius:8px; margin-bottom:16px; background:#fffbeb; border:1px solid #fcd34d; font-size:13px; color:#92400e;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#d97706" style="flex-shrink:0;">
            <path d="M12 2a10 10 0 100 20A10 10 0 0012 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
        </svg>
        <div>
            🔒 <strong>Modo Solo Lectura:</strong> Perteneces a la <strong>Planta @plantaAsignadaId</strong>. En Planta @plantaActivaId solo tienes permisos de consulta; la gestión de colaboradores está reservada para administradores locales o personal de Sistemas.
        </div>
    </div>
}

<div class="usuarios-container">

    <!-- PANEL IZQUIERDO: PADRÓN CORPORATIVO -->
    <div>
        <div class="panel-dark-header">
            <div style="display:flex; align-items:center; gap:8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                </svg>
                <span>Padrón Corporativo de Empleados</span>
            </div>
            <span class="badge" id="lblTotalEmpleados" style="background:rgba(255,255,255,0.2); font-size:11px; padding:3px 8px; border-radius:12px;">Cargando...</span>
        </div>

        <div class="search-bar-wrap">
            <div style="position:relative; flex:1;">
                <input type="text" id="txtBuscarEmpleado" class="form-control" placeholder="Buscar por nómina, nombre o CWID (Ej. 32352, Edwin, darijim1)..." autofocus style="width:100%; padding-left:34px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--text-muted)" style="position:absolute; left:10px; top:10px;">
                    <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
            </div>
            <button class="btn btn-primary btn-sm" id="btnBuscarEmpleado" type="button" style="padding:0 18px;">Buscar</button>
        </div>

        <div class="tbl-scroll-wrap">
            <table class="table-padron">
                <thead>
                    <tr>
                        <th style="width: 70px; text-align:center;">NÚM.</th>
                        <th>NOMBRE</th>
                        <th style="width: 120px;">CWID</th>
                        <th style="width: 80px;">PLANTA</th>
                        <th style="width: 90px; text-align:center;">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody id="tblColaboradoresBody">
                    <tr>
                        <td colspan="5" style="text-align:center; padding:30px; color:var(--text-muted);">
                            Cargando empleados del padrón corporativo...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- PANEL DERECHO: ASIGNAR ROL AL COLABORADOR -->
    <div>
        <div class="panel-blue-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
            <span>Asignar Rol al Colaborador</span>
        </div>

        <div class="right-card-body">
            <div id="msgAlerta" style="display:none; padding:12px; border-radius:8px; margin-bottom:16px; font-size:13px; font-weight:600;"></div>

            <div class="form-group" style="margin-bottom:18px;">
                <label for="txtColaboradorSeleccionado" style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:6px; text-transform:uppercase;">Colaborador Seleccionado:</label>
                <input type="text" id="txtColaboradorSeleccionado" class="form-control" placeholder="Selecciona un colaborador de la lista..." readonly style="background:#f8fafc; font-weight:600; color:#334155;">
                <input type="hidden" id="hdnCwid">
                <input type="hidden" id="hdnNombre">
                <input type="hidden" id="hdnNomina">
            </div>

            <div class="form-group" style="margin-bottom:20px;">
                <label for="ddlNivel" style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:6px; text-transform:uppercase;">Nivel de Acceso en Sistema:</label>
                <select id="ddlNivel" class="form-control" style="padding:10px; font-weight:600;" @(soloLectura ? "disabled" : "")>
                    <option value="10">Nivel 10 - Operador Logístico (Solo Agenda su Área)</option>
                    <option value="15">Nivel 15 - Programador de Logística (Formulario de Programación)</option>

                    @* CANDADO ESTRICTO: Solo si el nivel real en BD es mayor o igual a 30 (Admin o Sistemas) muestra el 20 y el 30 *@
                    @if (nivelReal >= 30)
                    {
                        <option value="20">Nivel 20 - Jefe de Logística (Programa y Aprueba)</option>
                        <option value="30">Nivel 30 - Administrador de Planta (Acceso Total a su Planta)</option>
                    }

                    @* Estrictamente exclusivo para Nivel 40 (Sistemas) *@
                    @if (nivelReal >= 40)
                    {
                        <option value="40">Nivel 40 - Sistemas (Superadmin / Solo Roles)</option>
                    }
                </select>
                
                <div style="font-size:12px; color:var(--text-muted); line-height:1.5; margin-top:12px; padding:10px; background:#f8fafc; border-radius:6px; border:1px solid #e2e8f0;">
                    @if (nivelReal >= 40)
                    {
                        <div>* <strong>Sistemas:</strong> Puede crear y asignar cualquier rol inter-planta con registro de auditoría técnica.</div>
                    }
                    else if (nivelReal == 20)
                    {
                        <div>* <strong>Jefe de Logística:</strong> Por seguridad, únicamente puedes otorgar roles operativos de Operador (Nivel 10) y Programador de Logística (Nivel 15) en tu planta.</div>
                    }
                    else
                    {
                        <div>* <strong>Administrador:</strong> Puede otorgar roles operativos y de jefatura en su planta asignada.</div>
                        <div style="margin-top:2px; color:#b45309;">* Solo el rol <strong>Sistemas</strong> puede asignar nuevos Administradores.</div>
                    }
                </div>
            </div>

            @if (soloLectura)
            {
                <button type="button" class="btn-guardar-permiso" disabled style="opacity:0.6; cursor:not-allowed;">
                    🔒 Guardar Permiso (Solo Lectura)
                </button>
            }
            else
            {
                <button type="button" id="btnGuardarPermiso" class="btn-guardar-permiso" disabled style="opacity:0.6;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                    Guardar Permiso
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    const esSoloLectura = @(soloLectura ? "true" : "false");

    document.addEventListener('DOMContentLoaded', () => {
        const txtBuscar = document.getElementById('txtBuscarEmpleado');
        const btnBuscar = document.getElementById('btnBuscarEmpleado');
        const tbody = document.getElementById('tblColaboradoresBody');
        const btnGuardar = document.getElementById('btnGuardarPermiso');
        const lblTotal = document.getElementById('lblTotalEmpleados');
        const msgBox = document.getElementById('msgAlerta');

        let debounceTimer;

        async function cargarEmpleados(filtro = '') {
            tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:30px; color:var(--text-muted);">Buscando en padrón corporativo...</td></tr>`;

            try {
                const resp = await fetch(`/Usuarios/BuscarColaboradoresCorporativos?query=${encodeURIComponent(filtro)}`);
                const res = await resp.json();

                if (!res.success || !res.data || res.data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:30px; color:var(--text-muted);">No se encontraron empleados coincidentes.</td></tr>`;
                    lblTotal.textContent = '0 resultados';
                    return;
                }

                lblTotal.textContent = `${res.data.length} mostrados`;

                tbody.innerHTML = res.data.map(e => `
                    <tr class="row-empleado">
                        <td style="text-align:center; font-weight:700; font-family:monospace;">${e.numero || ''}</td>
                        <td><strong>${e.nombre || ''}</strong></td>
                        <td><span class="badge-cwid">${e.cwid || 'Sin CWID'}</span></td>
                        <td style="color:var(--text-muted); font-size:12px;">${e.planta || ''}</td>
                        <td style="text-align:center;">
                            <button type="button" class="btn btn-secondary btn-sm btn-seleccionar"
                                    data-cwid="${e.cwid || ''}"
                                    data-nombre="${e.nombre || ''}"
                                    data-numero="${e.numero || ''}"
                                    ${esSoloLectura ? 'disabled style="opacity:0.55; cursor:not-allowed;" title="Modo Solo Lectura"' : ''}
                                    style="padding:2px 10px; font-size:12px;">
                                ${esSoloLectura ? '🔒 Ver' : 'Elegir &rarr;'}
                            </button>
                        </td>
                    </tr>
                `).join('');

                document.querySelectorAll('.row-empleado').forEach(tr => {
                    tr.addEventListener('click', () => {
                        const btn = tr.querySelector('.btn-seleccionar');
                        if (!btn) return;

                        const cwid = btn.dataset.cwid;
                        const nombre = btn.dataset.nombre;
                        const numero = btn.dataset.numero;

                        document.getElementById('txtColaboradorSeleccionado').value = `#${numero} - ${nombre} (${cwid || 'Sin CWID'})`;
                        document.getElementById('hdnCwid').value = cwid;
                        document.getElementById('hdnNombre').value = nombre;
                        document.getElementById('hdnNomina').value = numero;

                        if (!esSoloLectura && btnGuardar) {
                            btnGuardar.disabled = !cwid;
                            btnGuardar.style.opacity = !cwid ? '0.6' : '1';
                        }

                        document.querySelectorAll('.row-empleado').forEach(r => r.classList.remove('selected'));
                        tr.classList.add('selected');
                    });
                });

            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:30px; color:#dc2626;">Error al consultar el padrón corporativo.</td></tr>`;
                lblTotal.textContent = 'Error';
            }
        }

        txtBuscar.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                cargarEmpleados(txtBuscar.value.trim());
            }, 300);
        });

        btnBuscar.addEventListener('click', () => cargarEmpleados(txtBuscar.value.trim()));

        if (btnGuardar && !esSoloLectura) {
            btnGuardar.addEventListener('click', async () => {
                if (esSoloLectura) {
                    alert('Modo Solo Lectura: Acción bloqueada en plantas foráneas.');
                    return;
                }

                const cwid = document.getElementById('hdnCwid').value;
                const noEmpleado = document.getElementById('hdnNomina').value;
                const nombre = document.getElementById('hdnNombre').value;
                const nivel = parseInt(document.getElementById('ddlNivel').value, 10);

                if (!cwid) {
                    alert('El colaborador seleccionado no tiene una cuenta de red (CWID) vinculada.');
                    return;
                }

                btnGuardar.disabled = true;
                btnGuardar.innerText = 'Guardando...';

                try {
                    const resp = await fetch('/Usuarios/AsignarNivel', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cwid, noEmpleado, nombre, nivel })
                    });
                    
                    if (resp.status === 403) {
                        throw new Error('Operación rechazada: No tienes permisos para gestionar roles en esta planta.');
                    }

                    const res = await resp.json();

                    msgBox.style.display = 'block';
                    if (res.success) {
                        msgBox.style.background = '#dcfce7';
                        msgBox.style.border = '1px solid #86efac';
                        msgBox.style.color = '#15803d';
                        msgBox.innerText = `✔ ${res.message}`;
                    } else {
                        msgBox.style.background = '#fee2e2';
                        msgBox.style.border = '1px solid #f87171';
                        msgBox.style.color = '#991b1b';
                        msgBox.innerText = `✖ ${res.message}`;
                    }
                } catch (err) {
                    msgBox.style.display = 'block';
                    msgBox.style.background = '#fee2e2';
                    msgBox.style.border = '1px solid #f87171';
                    msgBox.style.color = '#991b1b';
                    msgBox.innerText = `✖ ${err.message}`;
                } finally {
                    btnGuardar.disabled = false;
                    btnGuardar.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Guardar Permiso`;
                }
            });
        }

        cargarEmpleados();
    });
</script>
}