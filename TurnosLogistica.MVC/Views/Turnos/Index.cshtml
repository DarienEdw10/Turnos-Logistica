@model List<TurnosLogistica.MVC.Models.TurnoViewModel>
@{
    ViewData["Title"] = "Gestión de Turnos";

    // =============================================================
    // EVALUACIÓN DE AISLAMIENTO MULTIPLANTA
    // =============================================================
    int plantaAsignadaId = 1;
    if (int.TryParse(User.FindFirst("PlantaAsignadaId")?.Value, out int pAsig))
    {
        plantaAsignadaId = pAsig;
    }

    int nivelUsuario = 10;
    if (int.TryParse(User.FindFirst("NivelJerarquico")?.Value, out int nVal))
    {
        nivelUsuario = nVal;
    }

    string rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower() ?? "operador";

    int plantaActivaId = 1;
    if (Context.Request.Cookies.TryGetValue("PlantaActivaId", out string? cookieVal) && int.TryParse(cookieVal, out int parsedId))
    {
        plantaActivaId = parsedId;
    }

    bool esPlantaForanea = (plantaActivaId != plantaAsignadaId);
    bool esPersonalSistemas = (nivelUsuario >= 40 || rolUsuario == "sistemas");
    bool soloLectura = esPlantaForanea && !esPersonalSistemas;
}

<div class="page-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div>
        <div class="page-title" style="font-size:20px; font-weight:700;">Gestión de Turnos</div>
        <div class="page-subtitle" style="color:var(--text-muted); font-size:14px;">Configuración de turnos, paros programados y tiempo neto efectivo — Planta @plantaActivaId</div>
    </div>
    @if (soloLectura)
    {
        <button class="btn btn-secondary btn-sm" disabled style="opacity:0.55; cursor:not-allowed;" title="Modo Solo Lectura: Tu planta base es la Planta @plantaAsignadaId. En Planta @plantaActivaId la configuración de turnos está bloqueada.">
            🔒 + Agregar Turno
        </button>
    }
    else
    {
        <button class="btn btn-primary btn-sm" onclick="abrirModalTurno(0)">+ Agregar Turno</button>
    }
</div>

<div class="card" style="padding:0">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Nombre</th>
                    <th>Hora Inicio</th>
                    <th>Hora Fin</th>
                    <th>Duración Bruta</th>
                    <th>Paros Ligados</th>
                    <th>Tiempo Neto</th>
                    <th>Estado</th>
                    <th style="text-align:center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td><span class="badge badge-@t.ClaseColor">@t.Clave</span></td>
                            <td><strong>@t.Nombre</strong></td>
                            <td>@t.HoraInicio.ToString(@"hh\:mm")</td>
                            <td>
                                @t.HoraFin.ToString(@"hh\:mm") @(t.HoraFin <= t.HoraInicio ? "(+1)" : "")
                            </td>
                            <td>@t.Horas hrs</td>
                            <td>
                                <span class="badge badge-encurso">@(t.TotalMinutosParo ?? 0) min</span>
                            </td>
                            <td>
                                <span class="badge badge-programado" style="font-weight:700;">@(t.TiempoNetoHoras ?? t.Horas) hrs</span>
                            </td>
                            <td>
                                @if (t.Activo)
                                {
                                    <span class="badge badge-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactivo">Inactivo</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (soloLectura)
                                {
                                    <button class="btn btn-secondary btn-sm" disabled style="padding:4px 10px; font-size:11px; opacity:0.55; cursor:not-allowed;" title="Modo Solo Lectura">
                                        🔒 Solo Lectura
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" onclick="abrirModalTurno(@t.Id)">Editar</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="padding:24px; text-align:center; color:var(--text-muted);">
                            No hay turnos configurados para esta planta.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL FLOTANTE: AGREGAR / EDITAR TURNO CON PAROS DINÁMICOS -->
<div id="modalTurnoOverlay"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:250; align-items:center; justify-content:center;">
    <div style="background:var(--surface); border-radius:12px; padding:24px; width:100%; max-width:680px; max-height:92vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,0.25);">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h3 id="modalTurnoTitle" style="font-size:16px; font-weight:700; margin:0;">Agregar Turno</h3>
            <button type="button" onclick="cerrarModalTurno()"
                    style="background:none; border:none; font-size:18px; cursor:pointer; color:var(--text-muted);">&times;</button>
        </div>

        @if (soloLectura)
        {
            <div style="background:#fffbeb; border:1px solid #fde68a; color:#92400e; padding:8px 12px; border-radius:6px; font-size:12px; margin-bottom:12px;">
                🔒 <strong>Modo Solo Lectura:</strong> No tienes permisos para crear o modificar turnos en esta planta.
            </div>
        }

        <form id="formTurno" asp-controller="Turnos" asp-action="Guardar" method="post" onsubmit="return validarEnvioTurno()">
            @Html.AntiForgeryToken()
            <input type="hidden" id="turnoId" name="id" value="0" />

            <div class="form-group" style="margin-bottom:12px;">
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">
                    NOMBRE DEL TURNO *
                </label>
                <input type="text" id="turnoNombre" name="nombre" placeholder="Ej. 1er T — Matutino" required @(soloLectura ? "disabled" : "") />
            </div>

            <div class="form-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;">
                <div class="form-group">
                    <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">
                        HORA INICIO *
                    </label>
                    <input type="time" id="turnoHoraInicio" name="horaInicio" class="form-control" required onchange="recalcularTiempos()" @(soloLectura ? "disabled" : "") style="padding:8px 12px; font-size:13px; border-radius:6px; border:1px solid var(--border); background:var(--surface); color:var(--text); width:100%; box-sizing:border-box;" />
                </div>
                <div class="form-group">
                    <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">
                        HORA FIN *
                    </label>
                    <input type="time" id="turnoHoraFin" name="horaFin" class="form-control" required onchange="recalcularTiempos()" @(soloLectura ? "disabled" : "") style="padding:8px 12px; font-size:13px; border-radius:6px; border:1px solid var(--border); background:var(--surface); color:var(--text); width:100%; box-sizing:border-box;" />
                </div>
            </div>

            <!-- RESUMEN DE TIEMPOS DINÁMICOS -->
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-bottom:16px; background:var(--surface2); padding:14px; border-radius:8px; border:1px solid var(--border);">
                <div style="text-align:center;">
                    <span style="font-size:11px; color:var(--text-muted); font-weight:700; display:block; margin-bottom:2px;">DURACIÓN BRUTA</span>
                    <div id="lblDuracionBruta" style="font-size:15px; font-weight:800; color:var(--text);">0.00 h</div>
                </div>
                <div style="text-align:center; border-left:1px solid var(--border); border-right:1px solid var(--border);">
                    <span style="font-size:11px; color:var(--warning); font-weight:700; display:block; margin-bottom:2px;">TOTAL PAROS</span>
                    <div id="lblTotalParos" style="font-size:15px; font-weight:800; color:var(--warning);">0 min</div>
                </div>
                <div style="text-align:center;">
                    <span style="font-size:11px; color:var(--success); font-weight:700; display:block; margin-bottom:2px;">TIEMPO NETO</span>
                    <div id="lblTiempoNeto" style="font-size:15px; font-weight:800; color:var(--success);">0.00 h</div>
                </div>
            </div>

            <!-- SECCIÓN DE PAROS PROGRAMADOS LIGADOS -->
            <div style="margin-bottom:16px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text-muted); margin:0;">PAROS PROGRAMADOS ASOCIADOS AL TURNO</label>
                    @if (!soloLectura)
                    {
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="abrirSelectorParoGlobal()">+ Catálogo Global</button>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="agregarFilaParo()">+ Personalizado</button>
                        </div>
                    }
                </div>

                <div class="table-wrap">
                    <table style="font-size:12px;">
                        <thead>
                            <tr style="background:var(--surface2);">
                                <th>Motivo / Razón</th>
                                <th style="width:120px;">Duración (min)</th>
                                <th style="width:140px;">Tipo</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="listaParosBody">
                            <!-- Filas dinámicas generadas vía JavaScript -->
                        </tbody>
                    </table>
                </div>

                <div id="alertaExceso"
                     style="display:none; color:var(--danger); font-size:11.5px; font-weight:700; margin-top:8px;">
                    ⚠ El tiempo acumulado de paros excede o anula la duración bruta del turno.
                </div>
            </div>

            <div class="form-group" style="margin-bottom:16px;">
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px; font-weight:600;">
                    <input type="checkbox" id="turnoActivo" name="activo" value="true" checked @(soloLectura ? "disabled" : "") />
                    Turno Activo
                </label>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:20px; border-top:1px solid var(--border); padding-top:14px;">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalTurno()">Cancelar</button>
                @if (!soloLectura)
                {
                    <button type="submit" id="btnGuardarTurno" class="btn btn-primary">Guardar Turno</button>
                }
            </div>
        </form>
    </div>
</div>

<!-- MODAL SECUNDARIO: SELECTOR DESDE EL CATÁLOGO DE PAROS GLOBALES -->
<div id="modalSelectorParoGlobalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:280; align-items:center; justify-content:center;">
    <div style="background:#ffffff; border-radius:12px; padding:24px; width:100%; max-width:520px; box-shadow:0 20px 60px rgba(0,0,0,0.25);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h3 style="font-size:16px; font-weight:700; margin:0; color:#1e293b;">Seleccionar Paro del Catálogo Global</h3>
            <button type="button" onclick="cerrarSelectorParoGlobal()" style="background:none; border:none; font-size:18px; cursor:pointer; color:#64748b;">&times;</button>
        </div>

        <div style="margin-bottom:12px;">
            <input type="text" id="busquedaParoGlobalCat" class="form-control" placeholder="Buscar motivo en catálogo..." onkeyup="filtrarCatalogoParosGlobal()" style="width:100%; padding:8px; border-radius:6px; border:1px solid #e2e8f0; box-sizing:border-box;" />
        </div>

        <div class="table-wrap" style="max-height:260px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:6px;">
            <table style="font-size:12px; width:100%; border-collapse: collapse;">
                <thead>
                    <tr style="background:#f8fafc;">
                        <th style="padding:8px; text-align:left;">Motivo / Descripción</th>
                        <th style="width:90px; text-align:center; padding:8px;">Duración</th>
                        <th style="width:80px; text-align:center; padding:8px;">Acción</th>
                    </tr>
                </thead>
                <tbody id="listaCatalogoParosGlobalModal">
                    <!-- Dinámico -->
                </tbody>
            </table>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:8px; border-top:1px solid #e2e8f0; padding-top:14px; margin-top:16px;">
            <button type="button" class="btn btn-secondary btn-sm" onclick="cerrarSelectorParoGlobal()">Cerrar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const esSoloLectura = @(soloLectura ? "true" : "false");
        let indexParo = 0;
        let catalogoParosGlobalCache = [];

        function cerrarModalTurno() {
            const m = document.getElementById('modalTurnoOverlay');
            if (m) m.style.display = 'none';
        }

        function abrirModalTurno(id) {
            if (esSoloLectura) {
                alert('Modo Solo Lectura: No tienes permisos para gestionar turnos en esta planta.');
                return;
            }

            const overlay = document.getElementById('modalTurnoOverlay');
            const title = document.getElementById('modalTurnoTitle');
            const tbody = document.getElementById('listaParosBody');
            tbody.innerHTML = '';
            indexParo = 0;

            if (id === 0) {
                title.innerText = 'Agregar Turno';
                document.getElementById('turnoId').value = 0;
                document.getElementById('turnoNombre').value = '';
                document.getElementById('turnoHoraInicio').value = '06:00';
                document.getElementById('turnoHoraFin').value = '14:00';
                document.getElementById('turnoActivo').checked = true;

                agregarFilaParo('Comedor / Alimentos', 30);
                overlay.style.display = 'flex';
                recalcularTiempos();
            } else {
                title.innerText = 'Editar Turno';
                fetch(`/Turnos/ObtenerTurno?id=${id}`)
                    .then(r => {
                        if (r.status === 403) throw new Error('Acceso denegado.');
                        return r.json();
                    })
                    .then(data => {
                        document.getElementById('turnoId').value = data.id;
                        document.getElementById('turnoNombre').value = data.nombre;
                        
                        if (data.horaInicio) {
                            document.getElementById('turnoHoraInicio').value = data.horaInicio.substring(0, 5);
                        }
                        if (data.horaFin) {
                            document.getElementById('turnoHoraFin').value = data.horaFin.substring(0, 5);
                        }

                        document.getElementById('turnoActivo').checked = data.activo;

                        let listaParos = data.paros || data.Paros || [];
                        if (Array.isArray(listaParos) && listaParos.length > 0) {
                            listaParos.forEach(p => {
                                let motivo = p.tipoParo || p.TipoParo || '';
                                let duracion = p.duracionMinutos || p.DuracionMinutos || 15;
                                let pid = p.id || p.Id || 0;
                                agregarFilaParo(motivo, duracion, pid);
                            });
                        }
                        
                        overlay.style.display = 'flex';
                        recalcularTiempos();
                    })
                    .catch(err => {
                        alert(err.message || 'Error al obtener la información del turno.');
                    });
            }
        }

        // LÓGICA DE APERTURA DESDE EL CATÁLOGO GLOBAL DE PAROS (Reutilizando endpoint de Catálogos)
        function abrirSelectorParoGlobal() {
            const tbody = document.getElementById('listaCatalogoParosGlobalModal');
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:12px; color:var(--text-muted);">Cargando catálogo...</td></tr>';
            document.getElementById('modalSelectorParoGlobalOverlay').style.display = 'flex';

            fetch('/Catalogos/ObtenerParosProgramadosActivos')
                .then(r => {
                    if (!r.ok) throw new Error('Network response was not ok');
                    return r.json();
                })
                .then(data => {
                    tbody.innerHTML = '';
                    catalogoParosGlobalCache = data || [];
                    renderizarTablaCatalogoParosGlobal(catalogoParosGlobalCache);
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:12px; color:var(--danger);">Error al cargar el catálogo global.</td></tr>';
                });
        }

        function renderizarTablaCatalogoParosGlobal(paros) {
            const tbody = document.getElementById('listaCatalogoParosGlobalModal');
            tbody.innerHTML = '';

            if (paros.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:12px; color:var(--text-muted);">No hay paros registrados en el catálogo.</td></tr>';
                return;
            }

            paros.forEach(p => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="padding:8px;"><strong>${p.tipoParo}</strong><br/><span style="color:#64748b; font-size:11px;">${p.descripcion}</span></td>
                    <td style="text-align:center; padding:8px;">${p.duracionMinutos} min</td>
                    <td style="text-align:center; padding:8px;">
                        <button type="button" class="btn btn-primary btn-sm" style="padding:2px 8px; font-size:11px;" onclick="seleccionarParoGlobal('${p.tipoParo}', ${p.duracionMinutos})">Seleccionar</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filtrarCatalogoParosGlobal() {
            let filtro = document.getElementById('busquedaParoGlobalCat').value.toLowerCase();
            let filtrados = catalogoParosGlobalCache.filter(p => p.tipoParo.toLowerCase().includes(filtro) || p.descripcion.toLowerCase().includes(filtro));
            renderizarTablaCatalogoParosGlobal(filtrados);
        }

        function seleccionarParoGlobal(motivo, duracion) {
            agregarFilaParo(motivo, duracion, 0);
            cerrarSelectorParoGlobal();
        }

        function cerrarSelectorParoGlobal() {
            document.getElementById('modalSelectorParoGlobalOverlay').style.display = 'none';
        }

        function agregarFilaParo(motivo = '', minutos = 15, paroId = 0) {
            const tbody = document.getElementById('listaParosBody');
            const tr = document.createElement('tr');
            tr.className = 'fila-paro';

            const disabledAttr = esSoloLectura ? 'disabled' : '';

            tr.innerHTML = `
                <td>
                    <input type="hidden" name="Paros.Index" value="${indexParo}" />
                    <input type="hidden" name="Paros[${indexParo}].Id" value="${paroId}" />
                    <input type="hidden" name="Paros[${indexParo}].EsProgramado" value="true" />
                    <input type="text" name="Paros[${indexParo}].TipoParo" class="form-control form-control-sm paro-motivo" placeholder="Ej. Comedor / Junta" value="${motivo}" required ${disabledAttr} style="padding:6px 10px; font-size:12px; width:100%; box-sizing:border-box;" />
                </td>
                <td>
                    <input type="number" name="Paros[${indexParo}].DuracionMinutos" class="form-control form-control-sm paro-minutos" min="1" value="${minutos}" oninput="recalcularTiempos()" required ${disabledAttr} style="padding:6px 10px; font-size:12px; width:100%; box-sizing:border-box;" />
                </td>
                <td>
                    <span class="badge" style="background:#dbeafe; color:#1e40af; font-weight:700; padding:4px 8px;">Programado</span>
                </td>
                <td style="text-align:center;">
                    ${!esSoloLectura ? '<button type="button" class="btn btn-danger btn-sm" style="padding:2px 6px; font-size:11px;" onclick="eliminarFilaParo(this)">✕</button>' : ''}
                </td>
            `;
            tbody.appendChild(tr);
            indexParo++;
            recalcularTiempos();
        }

        function eliminarFilaParo(btn) {
            if (esSoloLectura) return;
            btn.closest('tr').remove();
            recalcularTiempos();
        }

        function obtenerMinutosBrutosTurno() {
            const hIni = document.getElementById('turnoHoraInicio').value;
            const hFin = document.getElementById('turnoHoraFin').value;
            if (!hIni || !hFin) return 0;

            const [h1, m1] = hIni.split(':').map(Number);
            const [h2, m2] = hFin.split(':').map(Number);

            let tInicioMin = h1 * 60 + m1;
            let tFinMin = h2 * 60 + m2;

            if (tFinMin <= tInicioMin) {
                tFinMin += 24 * 60;
            }

            return tFinMin - tInicioMin;
        }

        function recalcularTiempos() {
            const duracionBrutaMin = obtenerMinutosBrutosTurno();
            const duracionBrutaHoras = (duracionBrutaMin / 60).toFixed(2);
            document.getElementById('lblDuracionBruta').innerText = `${duracionBrutaHoras} h`;

            let inputsMinutos = document.querySelectorAll('.paro-minutos');
            let totalParoMinutos = 0;
            inputsMinutos.forEach(input => {
                let val = parseInt(input.value) || 0;
                if (val > 0) totalParoMinutos += val;
            });

            let tiempoNetoMinutos = duracionBrutaMin - totalParoMinutos;
            let alerta = document.getElementById('alertaExceso');
            let btnGuardar = document.getElementById('btnGuardarTurno');

            document.getElementById('lblTotalParos').innerText = `${totalParoMinutos} min (${(totalParoMinutos / 60).toFixed(2)} h)`;

            if (tiempoNetoMinutos <= 0 && duracionBrutaMin > 0) {
                if (alerta) alerta.style.display = 'block';
                if (btnGuardar && !esSoloLectura) btnGuardar.disabled = true;
                document.getElementById('lblTiempoNeto').style.color = 'var(--danger)';
                document.getElementById('lblTiempoNeto').innerText = '0.00 h (Inválido)';
            } else {
                if (alerta) alerta.style.display = 'none';
                if (btnGuardar && !esSoloLectura) btnGuardar.disabled = false;
                document.getElementById('lblTiempoNeto').style.color = 'var(--success)';
                document.getElementById('lblTiempoNeto').innerText = `${(tiempoNetoMinutos / 60).toFixed(2)} h`;
            }
        }

        function validarEnvioTurno() {
            if (esSoloLectura) {
                alert('Modo Solo Lectura: Acción rechazada.');
                return false;
            }

            const duracionBrutaMin = obtenerMinutosBrutosTurno();
            let totalParoMinutos = 0;
            document.querySelectorAll('.paro-minutos').forEach(input => {
                totalParoMinutos += parseInt(input.value) || 0;
            });

            if (duracionBrutaMin - totalParoMinutos <= 0) {
                if (!confirm('Advertencia: El tiempo neto de corrida es menor o igual a cero. ¿Deseas continuar?')) {
                    return false;
                }
            }
            return true;
        }
    </script>
}