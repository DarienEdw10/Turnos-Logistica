@model TurnosLogistica.MVC.Models.EstructuraViewModel
@{
    ViewData["Title"] = "Gestión de Estructura";
}

<div class="page-header">
    <div>
        <div class="page-title">Gestión de Estructura</div>
        <div class="page-subtitle">Jerarquía: Planta &rarr; Proyecto &rarr; Línea &rarr; Celda (WorkCenter) &rarr; Estación</div>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; align-items:start;">

    <!-- PANEL IZQUIERDO: ÁRBOL DE ESTRUCTURA -->
    <div class="card" style="padding:20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <div class="card-title" style="margin:0;">Árbol de Estructura</div>
            <button type="button" class="btn btn-primary btn-sm" onclick="abrirModalNodo()">+ Nodo</button>
        </div>

        <ul class="tree" style="margin:0; padding-left:0;">
            <li class="tree-node">
                <!-- Nivel Planta -->
                <div class="tree-label level-planta" onclick="toggleTree('planta-root')">
                    <span class="tree-toggle" id="toggle-planta-root">&#9660;</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="var(--accent)">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                    </svg>
                    <span>@Model.PlantaNombre</span>
                </div>

                <ul class="tree-children" id="children-planta-root">
                    @foreach (var pry in Model.Proyectos)
                    {
                        <li class="tree-node">
                            <!-- Nivel Proyecto -->
                            <div class="tree-label level-proyecto" onclick="toggleTree('pry-@pry.Id')">
                                <span class="tree-toggle" id="toggle-pry-@pry.Id">&#9660;</span>
                                <span>@pry.Codigo — @pry.Nombre</span>
                            </div>

                            <ul class="tree-children" id="children-pry-@pry.Id">
                                @foreach (var lin in pry.Lineas)
                                {
                                    <li class="tree-node">
                                        <!-- Nivel Línea -->
                                        <div class="tree-label level-linea" onclick="toggleTree('lin-@lin.Id')">
                                            <span class="tree-toggle" id="toggle-lin-@lin.Id">&#9660;</span>
                                            <span>@lin.Nombre</span>
                                        </div>

                                        <ul class="tree-children" id="children-lin-@lin.Id">
                                            @foreach (var cel in lin.Celdas)
                                            {
                                                <li class="tree-node">
                                                    <!-- Nivel Celda / WorkCenter -->
                                                    <div class="tree-label level-celda"
                                                         onclick="seleccionarCeldaArbol(@cel.Id); toggleTree('cel-@cel.Id');">
                                                        <span class="tree-toggle" id="toggle-cel-@cel.Id">&#9660;</span>
                                                        <strong>@cel.Codigo</strong> <span>— @cel.Nombre</span>
                                                    </div>

                                                    <ul class="tree-children" id="children-cel-@cel.Id">
                                                        @foreach (var est in cel.Estaciones)
                                                        {
                                                            <li class="tree-node">
                                                                <div class="tree-label level-estacion">
                                                                    <span style="display:inline-block; width:12px;"></span>
                                                                    <span>@est</span>
                                                                </div>
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </li>
        </ul>
    </div>

    <!-- PANEL DERECHO: VINCULACIÓN CELDA -> NÚMEROS DE PARTE -->
    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:14px;">Celda &rarr; Números de Parte</div>

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:6px;">
                CELDA / WORKCENTER SELECCIONADO
            </label>
            <select id="selectCeldaPartes" class="form-control" onchange="cargarPartesDeCelda(this.value)">
                <option value="">-- Seleccione una celda --</option>
                @foreach (var c in Model.CeldasDisponibles)
                {
                    <option value="@c.Id">@c.Texto</option>
                }
            </select>
        </div>

        <div style="font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:8px;">
            Partes Asignadas a esta Celda (WorkCenter)
        </div>

        <div id="contenedorPartesAsignadas"
             style="display:flex; flex-wrap:wrap; gap:8px; min-height:80px; padding:12px; border:1px solid var(--border); border-radius:8px; background:var(--bg); margin-bottom:16px;">
            <span style="color:var(--text-muted); font-size:12px;">Seleccione una celda para ver y gestionar sus números de parte.</span>
        </div>

        <button type="button" class="btn btn-primary" onclick="guardarAsignacionMensaje()">Guardar asignación</button>
    </div>

</div>

<!-- MODAL AGREGAR NODO -->
<div id="modalNodoOverlay"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:250; align-items:center; justify-content:center;">
    <div style="background:var(--surface); border-radius:12px; padding:24px; width:100%; max-width:440px; box-shadow:0 20px 60px rgba(0,0,0,0.25);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h3 style="font-size:16px; font-weight:700; margin:0;">Agregar Nodo a la Estructura</h3>
            <button type="button" onclick="cerrarModalNodo()"
                    style="background:none; border:none; font-size:18px; cursor:pointer; color:var(--text-muted);">&times;</button>
        </div>

        <form asp-controller="Estructura" asp-action="AgregarNodo" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:12px;">
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">NIVEL JERÁRQUICO *</label>
                <select name="tipoNodo" id="tipoNodo" class="form-control" onchange="cambiarPadreSegunTipo(this.value)" required>
                    <option value="proyecto" selected>Proyecto</option>
                    <option value="linea">Línea</option>
                    <option value="celda">Celda (Workcenter)</option>
                    <option value="estacion">Estación</option>
                </select>
            </div>

            <!-- SELECTOR DE PROYECTO EXISTENTE (Visible solo si Nivel = Proyecto) -->
            <div class="form-group" id="grupoProyectoExistente" style="margin-bottom:12px; display:none;">
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">
                    SELECCIONAR PROYECTO EXISTENTE O CREAR *
                </label>
                <select id="selectProyectoExistente" class="form-control" onchange="alCambiarProyectoExistente(this.value)">
                    <option value="nuevo">+ Crear Nuevo Proyecto...</option>
                </select>
                <small style="font-size:10.5px; color:var(--text-muted); display:block; margin-top:3px;">
                    Selecciona uno existente para asociarlo o elige crear uno nuevo.
                </small>
            </div>

            <!-- PADRE (Visible si Nivel = Línea, Celda o Estación) -->
            <div class="form-group" id="grupoPadre" style="margin-bottom:12px; display:none;">
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;" id="lblPadre">PADRE *</label>
                <select name="padreId" id="padreId" class="form-control" onchange="alCambiarPadreGeneral(this.value)"></select>
            </div>

            <!-- SELECTOR DE LÍNEAS EXISTENTES DEL PROYECTO (Visible solo si Nivel = Línea) -->
            <div class="form-group" id="grupoLineaExistente" style="margin-bottom:12px; display:none;">
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">
                    LÍNEAS ASOCIADAS A ESTE PROYECTO
                </label>
                <select id="selectLineaExistente" class="form-control" onchange="alCambiarLineaExistente(this.value)">
                    <option value="nueva">+ Crear Nueva Línea...</option>
                </select>
                <small style="font-size:10.5px; color:var(--text-muted); display:block; margin-top:3px;">
                    Selecciona una línea para cargar sus datos o elige crear una nueva.
                </small>
            </div>

            <!-- CAMPO CÓDIGO -->
            <div class="form-group" style="margin-bottom:12px;">
                <label id="lblCodigo" style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">
                    CÓDIGO *
                </label>
                <input type="text" id="txtCodigoNodo" name="codigo" class="form-control" list="listaWorkCentersBD"
                       placeholder="Ej. PRY-CX727" required style="font-weight:700; letter-spacing:0.5px;" />
                <datalist id="listaWorkCentersBD"></datalist>
                <small id="helpCodigoNodo" style="font-size:10.5px; color:var(--text-muted); display:block; margin-top:3px;">
                    Código identificador del proyecto.
                </small>
            </div>

            <div class="form-group" style="margin-bottom:16px;">
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">NOMBRE *</label>
                <input type="text" id="txtNombreNodo" name="nombre" class="form-control" placeholder="Ej. Ford CX727 (Mustang Mach-E)" required />
            </div>

            <div style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalNodo()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear Nodo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleTree(id) {
            const children = document.getElementById('children-' + id);
            const toggle = document.getElementById('toggle-' + id);
            if (children) children.classList.toggle('collapsed');
            if (toggle) toggle.innerHTML = children && children.classList.contains('collapsed') ? '&#9654;' : '&#9660;';
        }

        function seleccionarCeldaArbol(celdaId) {
            const select = document.getElementById('selectCeldaPartes');
            if (select) {
                select.value = celdaId;
                cargarPartesDeCelda(celdaId);
            }
        }

        function cargarPartesDeCelda(celdaId) {
            const cont = document.getElementById('contenedorPartesAsignadas');
            if (!celdaId) {
                cont.innerHTML = '<span style="color:var(--text-muted); font-size:12px;">Seleccione una celda para ver sus números de parte.</span>';
                return;
            }

            cont.innerHTML = '<span style="color:var(--text-muted); font-size:12px;">Cargando partes...</span>';

            fetch(`/Estructura/ObtenerPartesPorCelda?celdaId=${celdaId}`)
                .then(r => r.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        cont.innerHTML = '<span style="color:var(--text-muted); font-size:12px;">No hay partes asignadas a esta celda.</span>';
                        return;
                    }
                    cont.innerHTML = '';
                    data.forEach(p => {
                        cont.innerHTML += `
                            <div class="ms-tag" style="display:inline-flex; align-items:center; gap:6px; background:var(--accent-light); color:var(--accent); border-radius:6px; padding:6px 10px; font-size:12px; font-weight:600;">
                                <span>${p.sapPartNumber} — ${p.descripcion}</span>
                                <button type="button" onclick="desvincularParte(${p.id}, ${celdaId})" style="border:none; background:none; cursor:pointer; color:var(--accent); font-weight:700; margin-left:4px;">&times;</button>
                            </div>
                        `;
                    });
                });
        }

        function desvincularParte(parteId, celdaId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch(`/Estructura/DesvincularParte`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `parteId=${parteId}&__RequestVerificationToken=${token}`
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    cargarPartesDeCelda(celdaId);
                }
            });
        }

        const proyectosDisponibles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProyectosJson ?? new object[] { }));
        const lineasDisponibles    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LineasJson ?? new object[] { }));
        const celdasDisponibles    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CeldasJson ?? new object[] { }));
        let listaProyectosPlanta   = [];

        function abrirModalNodo() {
            const selTipo = document.getElementById('tipoNodo');
            selTipo.value = 'proyecto';

            document.getElementById('txtCodigoNodo').value = '';
            document.getElementById('txtNombreNodo').value = '';
            document.getElementById('txtCodigoNodo').readOnly = false;
            document.getElementById('txtNombreNodo').readOnly = false;
            document.getElementById('listaWorkCentersBD').innerHTML = '';

            fetch('/Estructura/ObtenerProyectosPorPlanta')
                .then(r => r.json())
                .then(proyectos => {
                    listaProyectosPlanta = proyectos || [];
                    poblarSelectProyectosExistentes();
                    cambiarPadreSegunTipo('proyecto');
                    document.getElementById('modalNodoOverlay').style.display = 'flex';
                })
                .catch(() => {
                    listaProyectosPlanta = proyectosDisponibles || [];
                    poblarSelectProyectosExistentes();
                    cambiarPadreSegunTipo('proyecto');
                    document.getElementById('modalNodoOverlay').style.display = 'flex';
                });
        }

        function cerrarModalNodo() {
            document.getElementById('modalNodoOverlay').style.display = 'none';
            document.getElementById('txtCodigoNodo').value = '';
            document.getElementById('txtNombreNodo').value = '';
            document.getElementById('txtCodigoNodo').readOnly = false;
            document.getElementById('txtNombreNodo').readOnly = false;
        }

        function poblarSelectProyectosExistentes() {
            const sel = document.getElementById('selectProyectoExistente');
            if (!sel) return;

            sel.innerHTML = '<option value="nuevo">+ Crear Nuevo Proyecto...</option>';
            listaProyectosPlanta.forEach(p => {
                sel.innerHTML += `<option value="${p.id}" data-codigo="${p.codigo}" data-nombre="${p.nombre}">${p.texto}</option>`;
            });
        }

        function alCambiarProyectoExistente(valor) {
            const txtCodigo = document.getElementById('txtCodigoNodo');
            const txtNombre = document.getElementById('txtNombreNodo');

            if (valor === 'nuevo') {
                txtCodigo.value = '';
                txtNombre.value = '';
                txtCodigo.readOnly = false;
                txtNombre.readOnly = false;
                txtCodigo.placeholder = 'Ej. PRY-CX727 o MP';
                txtNombre.placeholder = 'Ej. Ford CX727 (Mustang Mach-E)';
            } else {
                const sel = document.getElementById('selectProyectoExistente');
                const opcion = sel.options[sel.selectedIndex];

                txtCodigo.value = opcion.getAttribute('data-codigo') || '';
                txtNombre.value = opcion.getAttribute('data-nombre') || '';

                txtCodigo.readOnly = true;
                txtNombre.readOnly = true;
            }
        }

        function cambiarPadreSegunTipo(tipo) {
            const grpProyectoExistente = document.getElementById('grupoProyectoExistente');
            const grpLineaExistente    = document.getElementById('grupoLineaExistente');
            const grpPadre             = document.getElementById('grupoPadre');
            const lblPadre             = document.getElementById('lblPadre');
            const selPadre             = document.getElementById('padreId');
            const lblCodigo            = document.getElementById('lblCodigo');
            const helpCodigo           = document.getElementById('helpCodigoNodo');
            const txtCodigo            = document.getElementById('txtCodigoNodo');
            const txtNombre            = document.getElementById('txtNombreNodo');
            const dataList             = document.getElementById('listaWorkCentersBD');

            // Limpieza general previa
            txtCodigo.value = '';
            txtNombre.value = '';
            txtCodigo.readOnly = false;
            txtNombre.readOnly = false;
            dataList.innerHTML = '';
            selPadre.innerHTML = '';

            if (tipo === 'proyecto') {
                grpPadre.style.display = 'none';
                grpLineaExistente.style.display = 'none';
                grpProyectoExistente.style.display = 'block';

                lblCodigo.innerText = 'CÓDIGO *';
                txtCodigo.placeholder = 'Ej. PRY-CX727 o MP';
                helpCodigo.innerText = 'Código identificador del proyecto.';
                txtNombre.placeholder = 'Ej. Ford CX727 (Mustang Mach-E)';

                const selPry = document.getElementById('selectProyectoExistente');
                if (selPry) selPry.value = 'nuevo';
            }
            else if (tipo === 'linea') {
                grpProyectoExistente.style.display = 'none';
                grpLineaExistente.style.display = 'block';
                lblPadre.innerText = 'PROYECTO PADRE *';

                const fuenteProyectos = listaProyectosPlanta.length > 0 ? listaProyectosPlanta : proyectosDisponibles;
                fuenteProyectos.forEach(p => {
                    selPadre.innerHTML += `<option value="${p.id}">${p.texto}</option>`;
                });

                grpPadre.style.display = 'block';
                lblCodigo.innerText = 'CÓDIGO *';
                txtCodigo.placeholder = 'Ej. L-BARRAS';
                helpCodigo.innerText = 'Código o clave de la línea de producción.';
                txtNombre.placeholder = 'Ej. Línea Barras de Ensamble';

                if (selPadre.value) {
                    cargarLineasDeProyecto(selPadre.value);
                }
            }
            else if (tipo === 'celda') {
                grpProyectoExistente.style.display = 'none';
                grpLineaExistente.style.display = 'none';
                lblPadre.innerText = 'LÍNEA PADRE *';

                lineasDisponibles.forEach(l => {
                    selPadre.innerHTML += `<option value="${l.id}">${l.texto}</option>`;
                });

                grpPadre.style.display = 'block';
                lblCodigo.innerText = 'CÓDIGO (WORKCENTER) *';
                txtCodigo.placeholder = 'Ej. ATKC001A';
                helpCodigo.innerText = 'WorkCenter oficial registrado en base de datos para esta línea.';
                txtNombre.placeholder = 'Ej. Celda ATKC001A';

                if (selPadre.value) {
                    cargarWorkCentersDeLinea(selPadre.value);
                }
            }
            else if (tipo === 'estacion') {
                grpProyectoExistente.style.display = 'none';
                grpLineaExistente.style.display = 'none';
                lblPadre.innerText = 'CELDA (WORKCENTER) PADRE *';

                const celdasFuente = celdasDisponibles.length > 0 ? celdasDisponibles : [];
                celdasFuente.forEach(c => {
                    selPadre.innerHTML += `<option value="${c.id}">${c.texto}</option>`;
                });

                grpPadre.style.display = 'block';
                lblCodigo.innerText = 'CÓDIGO *';
                txtCodigo.placeholder = 'Ej. EST-01';
                helpCodigo.innerText = 'Código identificador de la estación dentro de la celda.';
                txtNombre.placeholder = 'Ej. Carga Robot o Ensamble';
            }
        }

        // Enrutador de cambios en padreId
        function alCambiarPadreGeneral(padreId) {
            const tipo = document.getElementById('tipoNodo').value;
            if (tipo === 'linea') {
                cargarLineasDeProyecto(padreId);
            } else if (tipo === 'celda') {
                cargarWorkCentersDeLinea(padreId);
            }
        }

        function cargarLineasDeProyecto(proyectoId) {
            const selLinea  = document.getElementById('selectLineaExistente');
            const txtCodigo = document.getElementById('txtCodigoNodo');
            const txtNombre = document.getElementById('txtNombreNodo');

            txtCodigo.value = '';
            txtNombre.value = '';
            txtCodigo.readOnly = false;
            txtNombre.readOnly = false;
            selLinea.innerHTML = '<option value="nueva">+ Crear Nueva Línea...</option>';

            if (!proyectoId) return;

            fetch(`/Estructura/ObtenerLineasPorProyecto?proyectoId=${proyectoId}`)
                .then(r => r.json())
                .then(lineas => {
                    if (lineas && lineas.length > 0) {
                        lineas.forEach(l => {
                            selLinea.innerHTML += `<option value="${l.id}" data-codigo="${l.codigo}" data-nombre="${l.nombre}">${l.texto}</option>`;
                        });
                    }
                });
        }

        function alCambiarLineaExistente(valor) {
            const txtCodigo = document.getElementById('txtCodigoNodo');
            const txtNombre = document.getElementById('txtNombreNodo');

            if (valor === 'nueva') {
                txtCodigo.value = '';
                txtNombre.value = '';
                txtCodigo.readOnly = false;
                txtNombre.readOnly = false;
                txtCodigo.placeholder = 'Ej. L-BARRAS';
                txtNombre.placeholder = 'Ej. Línea Barras de Ensamble';
            } else {
                const sel = document.getElementById('selectLineaExistente');
                const opcion = sel.options[sel.selectedIndex];

                txtCodigo.value = opcion.getAttribute('data-codigo') || '';
                txtNombre.value = opcion.getAttribute('data-nombre') || '';

                txtCodigo.readOnly = true;
                txtNombre.readOnly = true;
            }
        }

        function cargarWorkCentersDeLinea(lineaId) {
            const txtCodigo = document.getElementById('txtCodigoNodo');
            const txtNombre = document.getElementById('txtNombreNodo');
            const dataList  = document.getElementById('listaWorkCentersBD');

            txtCodigo.value = '';
            txtNombre.value = '';
            dataList.innerHTML = '';

            if (!lineaId) return;

            fetch(`/Estructura/ObtenerWorkCentersPorLinea?lineaId=${lineaId}`)
                .then(r => r.json())
                .then(data => {
                    if (data && data.workCenters && data.workCenters.length > 0) {
                        data.workCenters.forEach(wc => {
                            dataList.innerHTML += `<option value="${wc}">${wc}</option>`;
                        });
                        txtCodigo.value = data.sugerido || '';
                        txtNombre.value = txtCodigo.value ? `Celda ${txtCodigo.value}` : '';
                    } else {
                        txtCodigo.value = '';
                        txtNombre.value = '';
                        txtCodigo.placeholder = 'Ej. ATKC099A';
                        txtNombre.placeholder = 'Ej. Celda ATKC099A';
                    }
                })
                .catch(() => {
                    txtCodigo.value = '';
                    txtNombre.value = '';
                });
        }

        // Sincronizar nombre dinámico únicamente si es Celda
        document.getElementById('txtCodigoNodo').addEventListener('input', function (e) {
            const tipo = document.getElementById('tipoNodo').value;
            if (tipo === 'celda') {
                const val = e.target.value.trim().toUpperCase();
                document.getElementById('txtNombreNodo').value = val ? `Celda ${val}` : '';
            }
        });

        function guardarAsignacionMensaje() {
            alert('Asignación de números de parte guardada correctamente.');
        }
    </script>
}