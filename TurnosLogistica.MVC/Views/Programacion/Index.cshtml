@{
    ViewData["Title"] = "Formulario de Programación";
}

<div class="page-header">
    <div>
        <div class="page-title">Formulario de Programación</div>
        <div class="page-subtitle">Nueva entrada de producción — campos en cascada</div>
    </div>
</div>

<div class="card">
    <div class="card-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent)"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
        Datos de la Programación
    </div>

    <form asp-action="Guardar" method="post">
        <div class="form-grid">
            <div class="form-group">
                <label>Proyecto *</label>
                <select name="proyecto">
                    <option selected>PRY-CAMRY-25</option>
                    <option>PRY-TUNDRA-X</option>
                    <option>PRY-SEQUOIA</option>
                </select>
            </div>
            <div class="form-group">
                <label>Línea *</label>
                <select name="linea">
                    <option selected>Línea A-1</option>
                    <option>Línea A-2</option>
                </select>
            </div>
            <div class="form-group">
                <label>Celda *</label>
                <select name="celda">
                    <option selected>C-101 — Ensamble Frontal</option>
                    <option>C-102 — Ensamble Lateral</option>
                </select>
            </div>
            <div class="form-group">
                <label>Estación *</label>
                <select name="estacion">
                    <option selected>EST-03 — Torque</option>
                    <option>EST-04 — Inspección</option>
                </select>
            </div>
            <div class="form-group">
                <label>Fecha de producción *</label>
                <input type="date" name="fecha" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
        </div>

        <hr class="divider" />

        <div class="form-grid">
            <div class="form-group full">
                <label>Número(s) de parte * (Vinculados a Celda)</label>
                <div class="multi-select-mock">
                    <div class="ms-tag">84350742 — Bracket Asm Front<button type="button">x</button></div>
                    <div class="ms-tag">84350743 — Bracket Asm Rear<button type="button">x</button></div>
                </div>
            </div>
            <div class="form-group full">
                <label>Turno *</label>
                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" name="turno" value="t1" checked />
                        <span class="badge badge-t1">T1</span> Matutino (06:00–15:36)
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="turno" value="t2" />
                        <span class="badge badge-t2">T2</span> Vespertino (14:00–21:30)
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="turno" value="t3" />
                        <span class="badge badge-t3">T3</span> Nocturno (21:30–06:00)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label>Tiempo estimado (hrs)</label>
                <input type="number" name="tiempoEstimado" value="8" step="0.5" />
            </div>
            <div class="form-group full">
                <label>Razón * (Obligatoria)</label>
                <textarea name="razon" placeholder="Describa la razón de la programación..." required></textarea>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar Programación</button>
            <a asp-controller="Calendario" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>