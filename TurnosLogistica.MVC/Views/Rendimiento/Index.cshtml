@model TurnosLogistica.MVC.Models.RendimientoTurnoViewModel
@{
    ViewData["Title"] = "Rendimiento y Cierre de Turno";

    // =============================================================
    // EVALUACIÓN DE AISLAMIENTO MULTIPLANTA Y JERARQUÍA
    // =============================================================
    int plantaAsignadaId = 1;
    if (int.TryParse(User.FindFirst("PlantaAsignadaId")?.Value, out int pAsig))
    {
        plantaAsignadaId = pAsig;
    }

    int nivelUsuario = 10;
    if (int.TryParse(User.FindFirst("NivelJerarquico")?.Value, out int nVal))
    {
        nivelUsuario = nVal;
    }

    string rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower() ?? "operador";

    int plantaActivaId = 1;
    if (Context.Request.Cookies.TryGetValue("PlantaActivaId", out string? cookieVal) && int.TryParse(cookieVal, out int parsedId))
    {
        plantaActivaId = parsedId;
    }

    bool esPlantaForanea = (plantaActivaId != plantaAsignadaId);
    bool esPersonalSistemas = (nivelUsuario >= 40 || rolUsuario == "sistemas");
    bool soloLectura = esPlantaForanea && !esPersonalSistemas;
}

<div class="page-header">
    <div>
        <div class="page-title">Rendimiento de Producción</div>
        <div class="page-subtitle">Balance de tiempo bruto vs. tiempo neto real y registro de paros en piso (Turno 06:00 a 15:36)</div>
    </div>
    <div style="display:flex; gap:8px;">
        <a class="btn btn-secondary" asp-action="ExportarCsv" asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")"
           asp-route-turno="@Model.FiltroTurno" asp-route-linea="@Model.FiltroLinea">
            📥 Exportar a Excel (CSV)
        </a>
    </div>
</div>

<!-- BARRA DE FILTROS -->
<form method="get" asp-action="Index" class="filter-bar">
    <div class="filter-group">
        <label>Fecha</label>
        <input type="date" name="fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </div>

    <div class="filter-group">
        <label>Turno</label>
        <select name="turno" onchange="this.form.submit()">
            <option value="Todos">Todos</option>
            @foreach (var t in Model.TurnosDisponibles)
            {
                <option value="@t" selected="@(Model.FiltroTurno == t)">@t</option>
            }
        </select>
    </div>

    <div class="filter-group">
        <label>Línea</label>
        <select name="linea" onchange="this.form.submit()">
            <option value="Todas">Todas</option>
            @foreach (var l in Model.LineasDisponibles)
            {
                <option value="@l" selected="@(Model.FiltroLinea == l)">@l</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    <a asp-action="Index" class="btn btn-secondary btn-sm" style="text-decoration:none;display:inline-flex;align-items:center;">Limpiar</a>
</form>

<!-- CARDS DE CONSOLIDADO GENERAL DEL DÍA -->
<div class="stats-row" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
    <div class="stat-card">
        <div class="stat-label">Horas Planeadas</div>
        <div class="stat-value">@Model.TotalHorasProgramadas h</div>
        <div class="stat-sub">Tiempo bruto en piso</div>
    </div>

    <div class="stat-card">
        <div class="stat-label" style="color:var(--warning);">Paro Programado</div>
        <div class="stat-value" style="color:var(--warning);">@((Model.Items.Sum(i => i.MinutosParoProgramados) / 60.0).ToString("N2")) h</div>
        <div class="stat-sub">@Model.Items.Sum(i => i.MinutosParoProgramados) min acumulados</div>
    </div>

    <div class="stat-card">
        <div class="stat-label" style="color:#8606db;">Paro Temporal</div>
        <div class="stat-value" style="color:#8606db;">@((Model.Items.Sum(i => i.MinutosParoTemporales) / 60.0).ToString("N2")) h</div>
        <div class="stat-sub">@Model.Items.Sum(i => i.MinutosParoTemporales) min acumulados</div>
    </div>

    <div class="stat-card">
        <div class="stat-label" style="color:var(--danger);">Fallas / Incidencias</div>
        <div class="stat-value" style="color:var(--danger);">@((Model.Items.Sum(i => i.MinutosParoNoProgramados) / 60.0).ToString("N2")) h</div>
        <div class="stat-sub">@Model.Items.Sum(i => i.MinutosParoNoProgramados) min acumulados</div>
    </div>

    <div class="stat-card">
        <div class="stat-label" style="color:var(--success);">Tiempo Neto Real</div>
        <div class="stat-value" style="color:var(--success);">@Model.TotalHorasEfectivas h</div>
        <div class="stat-sub">Disponibilidad: @Model.EficienciaGeneralPct%</div>
    </div>
</div>

<!-- TABLA DE DETALLE OPERATIVO -->
<div class="card" style="padding:0;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Turno</th>
                    <th>Proyecto</th>
                    <th>Línea / Celda</th>
                    <th>No. Parte</th>
                    <th>T. Bruto</th>
                    <th>Paro Prog.</th>
                    <th>Paro Temporal</th>
                    <th>Fallas/Incidencias</th>
                    <th>T. Efectivo</th>
                    <th style="width:100px; text-align:center;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var row in Model.Items)
                    {
                        <tr>
                            <td><strong style="color:var(--accent);">@row.TurnoClave</strong></td>
                            <td><strong>@row.ProyectoCodigo</strong></td>
                            <td>@row.LineaNombre / @row.CeldaCodigo</td>
                            <td><code>@row.SapPartNumber</code></td>
                            <td>@row.HorasProgramadas.ToString("N2") h</td>
                            <td style="color:var(--warning);">@row.MinutosParoProgramados min</td>
                            <td style="color:#8606db; font-weight:700;">@(row.MinutosParoTemporales > 0 ? $"{row.MinutosParoTemporales} min" : "—")</td>
                            <td style="color:var(--danger); font-weight:700;">@row.MinutosParoNoProgramados min</td>
                            <td><strong style="color:var(--success);">@row.HorasEfectivas.ToString("N2") h</strong></td>

                            <td style="text-align:center;">
                                <button type="button" class="btn btn-secondary btn-sm"
                                        style="padding:3px 8px; font-size:11.5px; font-weight:600;"
                                        onclick="abrirModalParos(@row.ProgramacionId, '@row.ProyectoCodigo', '@row.LineaNombre', '@row.CeldaCodigo', @row.HorasProgramadas, '@row.SapPartNumber')">
                                    🔍 Historial
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" style="text-align:center; padding:30px; color:var(--text-muted);">
                            No hay órdenes de producción programadas para esta fecha o filtros seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL DE CONSULTA DE HISTORIAL DE PAROS -->
<div id="modalParosOverlay"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:300; align-items:center; justify-content:center; padding:16px;">
    <div style="background:var(--surface); border-radius:12px; padding:24px; width:100%; max-width:640px; max-height:92vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,0.3);">

        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px;">
            <div>
                <h3 id="modalProgTitulo" style="font-size:16px; font-weight:700; margin:0; color:var(--text);">Historial de Incidencias / Paros</h3>
                <span id="modalProgSubtitulo" style="font-size:12px; color:var(--text-muted);">Proyecto - Línea / Celda</span>
            </div>
            <button type="button" onclick="cerrarModalParos()"
                    style="background:none; border:none; font-size:22px; cursor:pointer; color:var(--text-muted);">&times;</button>
        </div>

        <!-- Ficha Resumen de Tiempos -->
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px; margin-bottom:14px; background:var(--surface2); padding:12px; border-radius:8px;">
            <div>
                <span style="font-size:10px; color:var(--text-muted); font-weight:700; display:block;">HORAS TURNO</span>
                <div id="lblModalHorasProg" style="font-size:14px; font-weight:800; color:var(--text);">0.00 h</div>
            </div>
            <div>
                <span style="font-size:10px; color:var(--warning); font-weight:700; display:block;">TOTAL PAROS</span>
                <div id="lblModalTotalParos" style="font-size:14px; font-weight:800; color:var(--warning);">0 min</div>
            </div>
            <div>
                <span style="font-size:10px; color:var(--success); font-weight:700; display:block;">TIEMPO EFECTIVO</span>
                <div id="lblModalTiempoNeto" style="font-size:14px; font-weight:800; color:var(--success);">0.00 h</div>
            </div>
        </div>

        <div class="table-wrap">
            <table style="font-size:12px;">
                <thead>
                    <tr style="background:var(--surface2);">
                        <th>Motivo / Razón</th>
                        <th style="width:105px;">Duración (min)</th>
                        <th style="width:160px;">Categoría / Tipo</th>
                    </tr>
                </thead>
                <tbody id="listaParosProyectoBody">
                    <!-- Filas dinámicas -->
                </tbody>
            </table>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:8px; border-top:1px solid var(--border); padding-top:14px; margin-top:16px;">
            <button type="button" class="btn btn-secondary" onclick="cerrarModalParos()">Cerrar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let horasProgActuales = 0;

        function cerrarModalParos() {
            document.getElementById('modalParosOverlay').style.display = 'none';
        }

        function abrirModalParos(id, proyecto, linea, celda, horas, parte = '') {
            document.getElementById('modalProgTitulo').innerText = `Historial — ${proyecto} ${parte ? '— ' + parte : ''}`;
            document.getElementById('modalProgSubtitulo').innerText = `${linea} / ${celda} — ${horas} hrs planeadas`;

            horasProgActuales = parseFloat(horas) || 0;
            document.getElementById('lblModalHorasProg').innerText = `${horasProgActuales.toFixed(2)} h`;

            const tbody = document.getElementById('listaParosProyectoBody');
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:10px; color:var(--text-muted);">Cargando historial...</td></tr>';
            document.getElementById('modalParosOverlay').style.display = 'flex';

            fetch(`/Calendario/ObtenerParosProgramacion?programacionId=${id}`)
                .then(r => r.json())
                .then(data => {
                    tbody.innerHTML = '';
                    if (data && data.length > 0) {
                        data.forEach(p => {
                            let cat = parseInt(p.categoriaParo, 10) || 1;
                            let motivo = p.descripcion || p.tipoParo;
                            agregarFilaHistorial(motivo, p.duracionMinutos, cat);
                        });
                    } else {
                        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:12px; color:var(--text-muted);">Sin paros o incidencias registradas en este turno.</td></tr>';
                    }
                    recalcularTiemposModal();
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:12px; color:var(--text-muted);">Error al cargar el historial.</td></tr>';
                    recalcularTiemposModal();
                });
        }

        function agregarFilaHistorial(motivo, minutos, categoriaParo) {
            const tbody = document.getElementById('listaParosProyectoBody');
            
            let badgeTipo = '';
            if (categoriaParo === 1) badgeTipo = '<span style="color:#2563eb; font-weight:700;">🔵 Base / Turno</span>';
            else if (categoriaParo === 2) badgeTipo = '<span style="color:#d97706; font-weight:700;">🟠 Temporal (Día)</span>';
            else badgeTipo = '<span style="color:#dc2626; font-weight:700;">🔴 No Prog. (Falla)</span>';

            const tr = document.createElement('tr');
            tr.className = 'fila-paro-prog';
            tr.innerHTML = `
                <td>
                    <input type="text" class="form-control form-control-sm p-motivo" value="${motivo}" disabled style="background:var(--surface2); border:none; width:100%;" />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm p-minutos" value="${minutos}" disabled style="background:var(--surface2); border:none; width:100%;" />
                </td>
                <td>${badgeTipo}</td>
            `;
            tbody.appendChild(tr);
        }

        function recalcularTiemposModal() {
            let horasBase = parseFloat(horasProgActuales) || 0;
            let minutosTotalesProg = Math.round(horasBase * 60);
            let totalParoMinutos = 0;

            document.querySelectorAll('.p-minutos').forEach(input => {
                let val = parseInt(input.value, 10);
                if (!isNaN(val) && val > 0) {
                    totalParoMinutos += val;
                }
            });

            let tiempoNetoMinutos = minutosTotalesProg - totalParoMinutos;
            let lblTiempo = document.getElementById('lblModalTiempoNeto');
            let lblParos = document.getElementById('lblModalTotalParos');

            if (lblParos) {
                lblParos.innerText = `${totalParoMinutos} min (${(totalParoMinutos / 60).toFixed(2)} h)`;
            }

            let horasDecimal = Math.max(0, tiempoNetoMinutos) / 60;
            let hEnteras = Math.floor(Math.max(0, tiempoNetoMinutos) / 60);
            let mRestantes = Math.max(0, tiempoNetoMinutos) % 60;

            if (lblTiempo) {
                lblTiempo.style.color = 'var(--success)';
                lblTiempo.innerText = `${horasDecimal.toFixed(2)} h (${hEnteras}h ${mRestantes}m)`;
            }
        }
    </script>
}