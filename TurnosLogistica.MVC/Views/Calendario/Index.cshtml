@model TurnosLogistica.MVC.Models.CalendarioViewModel
@{
    ViewData["Title"] = "Calendario de Producción";
    string agrupacion = Model?.Agrupacion ?? "proyecto";
    string granularidad = Model?.Granularidad ?? "mensual";

    var fechaBase = Model?.FechaSeleccionada ?? DateTime.Today;
    var primerDiaMes = new DateTime(fechaBase.Year, fechaBase.Month, 1);
    var diasEnMes = DateTime.DaysInMonth(primerDiaMes.Year, primerDiaMes.Month);

    int diaInicioSemana = (int)primerDiaMes.DayOfWeek;
    diaInicioSemana = diaInicioSemana == 0 ? 7 : diaInicioSemana;

    var mesAnterior = primerDiaMes.AddMonths(-1);
    int diasMesAnterior = DateTime.DaysInMonth(mesAnterior.Year, mesAnterior.Month);
    int totalCeldasPrevias = diaInicioSemana - 1;

    // NAVEGACIÓN DINÁMICA SEGÚN GRANULARIDAD (Día, Semana o Mes)
    var fechaPrev = granularidad == "diario" ? fechaBase.AddDays(-1) : (granularidad == "semanal" ? fechaBase.AddDays(-7) : fechaBase.AddMonths(-1));
    var fechaNext = granularidad == "diario" ? fechaBase.AddDays(1) : (granularidad == "semanal" ? fechaBase.AddDays(7) : fechaBase.AddMonths(1));

    string textoPrev = granularidad == "diario" ? "◀ Día Anterior" : (granularidad == "semanal" ? "◀ Semana Anterior" : "◀ Mes Anterior");
    string textoNext = granularidad == "diario" ? "Día Siguiente ▶" : (granularidad == "semanal" ? "Semana Siguiente ▶" : "Mes Siguiente ▶");

    // =============================================================
    // EVALUACIÓN DE AISLAMIENTO MULTIPLANTA Y JERARQUÍA DE OPERADOR
    // =============================================================
    int plantaAsignadaId = 1;
    if (int.TryParse(User.FindFirst("PlantaAsignadaId")?.Value, out int pAsig))
    {
        plantaAsignadaId = pAsig;
    }

    int nivelUsuario = 10;
    if (int.TryParse(User.FindFirst("NivelJerarquico")?.Value, out int nVal))
    {
        nivelUsuario = nVal;
    }

    string rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower() ?? "operador";

    int plantaActivaId = Model?.PlantaId ?? 1;
    if (Context.Request.Cookies.TryGetValue("PlantaActivaId", out string? cookieVal) && int.TryParse(cookieVal, out int parsedId))
    {
        plantaActivaId = parsedId;
    }

    bool esPlantaForanea = (plantaActivaId != plantaAsignadaId);
    bool esPersonalSistemas = (nivelUsuario >= 40 || rolUsuario == "sistemas");
    bool soloLectura = esPlantaForanea && !esPersonalSistemas;
    bool esOperadorPuro = (nivelUsuario < 20);
}

<!-- ENCABEZADO CON NAVEGADOR DINÁMICO -->
<div class="page-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div>
        <div class="page-title" style="font-size:20px; font-weight:700;">Calendario de Producción</div>
        <div class="page-subtitle" style="color:var(--text-muted); font-size:14px;">
            Vista @granularidad.ToUpper() — Planta @plantaActivaId /
            @(granularidad == "diario"
                ? fechaBase.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("es-MX")).ToUpper()
                : (granularidad == "semanal"
                    ? $"Semana del {fechaBase.ToString("dd MMM", new System.Globalization.CultureInfo("es-MX"))}".ToUpper()
                    : primerDiaMes.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-MX")).ToUpper()))
        </div>
    </div>

    <!-- BOTONES DE CONTROL DE FECHA -->
    <div style="display:flex; align-items:center; gap:8px;">
        <a class="btn btn-secondary" style="padding:6px 12px; font-size:12px; font-weight:600; text-decoration:none;"
           href="?fecha=@fechaPrev.ToString("yyyy-MM-dd")&agrupacion=@agrupacion&granularidad=@granularidad&linea=@Model?.FiltroLinea&celda=@Model?.FiltroCelda&turno=@Model?.FiltroTurno">
            @textoPrev
        </a>

        <a class="btn btn-secondary" style="padding:6px 12px; font-size:12px; font-weight:600; text-decoration:none;"
           href="?fecha=@DateTime.Today.ToString("yyyy-MM-dd")&agrupacion=@agrupacion&granularidad=@granularidad&linea=@Model?.FiltroLinea&celda=@Model?.FiltroCelda&turno=@Model?.FiltroTurno">
            Hoy
        </a>

        <a class="btn btn-secondary" style="padding:6px 12px; font-size:12px; font-weight:600; text-decoration:none;"
           href="?fecha=@fechaNext.ToString("yyyy-MM-dd")&agrupacion=@agrupacion&granularidad=@granularidad&linea=@Model?.FiltroLinea&celda=@Model?.FiltroCelda&turno=@Model?.FiltroTurno">
            @textoNext
        </a>

        @if (soloLectura || nivelUsuario < 15)
        {
            <button type="button" class="btn btn-secondary" disabled
                    style="padding:6px 14px; font-size:13px; font-weight:600; opacity:0.55; cursor:not-allowed; margin-left:6px;"
                    title="Restringido para nuevas programaciones.">
                🔒 + Nueva Programación
            </button>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Programacion" asp-action="Index"
               style="padding:6px 14px; font-size:13px; font-weight:600; text-decoration:none; margin-left:6px;">
                + Nueva Programación
            </a>
        }
    </div>
</div>

<!-- BARRA DE LEYENDA (ESTADOS + TURNOS) -->
<div class="calendario-leyenda">
    <span style="color:var(--text-muted); font-weight:700; margin-right:4px;">ESTADOS:</span>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:#d97706;"></span>
        <span>Pendiente</span>
    </div>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:#2563eb;"></span>
        <span>Activo</span>
    </div>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:#16a34a;"></span>
        <span>Terminado</span>
    </div>

    <span style="color:var(--border); margin:0 8px;">|</span>

    <span style="color:var(--text-muted); font-weight:700; margin-right:4px;">TURNOS (BORDE):</span>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:var(--t1);"></span>
        <span>1T Matutino</span>
    </div>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:var(--t2);"></span>
        <span>2T Vespertino</span>
    </div>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:var(--t3);"></span>
        <span>3T Nocturno</span>
    </div>
    <div class="leyenda-item">
        <span class="leyenda-dot" style="background:var(--t12h);"></span>
        <span>12H</span>
    </div>
</div>

<!-- SEGMENTED DE AGRUPACIÓN Y GRANULARIDAD -->
<div class="card" style="padding:16px 20px; margin-bottom:16px;">
    <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:flex-end">
        <div>
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px">
                Agrupación
            </div>
            <div class="segmented">
                <a class="seg-btn @(agrupacion == "proyecto" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=proyecto&granularidad=@granularidad">Proyecto</a>
                <a class="seg-btn @(agrupacion == "linea" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=linea&granularidad=@granularidad">Línea (grupo)</a>
                <a class="seg-btn @(agrupacion == "celda" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=celda&granularidad=@granularidad">Celda</a>
                <a class="seg-btn @(agrupacion == "parte" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=parte&granularidad=@granularidad">Componente</a>
            </div>
        </div>
        <div>
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px">
                Granularidad
            </div>
            <div class="segmented">
                <a class="seg-btn @(granularidad == "mensual" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=@agrupacion&granularidad=mensual">Mensual</a>
                <a class="seg-btn @(granularidad == "semanal" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=@agrupacion&granularidad=semanal">Semanal</a>
                <a class="seg-btn @(granularidad == "diario" ? "active" : "")"
                   href="?fecha=@fechaBase.ToString("yyyy-MM-dd")&agrupacion=@agrupacion&granularidad=diario">Diario</a>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <form method="get" asp-controller="Calendario" asp-action="Index" class="filter-bar" style="margin-top:16px;">
        <input type="hidden" name="agrupacion" value="@Model?.Agrupacion" />
        <input type="hidden" name="granularidad" value="@Model?.Granularidad" />
        <input type="hidden" name="fecha" value="@fechaBase.ToString("yyyy-MM-dd")" />

        <div class="filter-group">
            <label>Línea</label>
            <select name="linea" id="filtroLineaCalendario">
                <option value="Todas" selected="@(string.IsNullOrEmpty(Model?.FiltroLinea) || Model?.FiltroLinea == "Todas")">Todas</option>
                @if (Model?.LineasDisponibles != null)
                {
                    @foreach (var l in Model.LineasDisponibles)
                    {
                        <option value="@l" selected="@(Model?.FiltroLinea == l)">@l</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Celda</label>
            <select name="celda" id="filtroCeldaCalendario">
                <option value="Todas" selected="@(string.IsNullOrEmpty(Model?.FiltroCelda) || Model?.FiltroCelda == "Todas")">Todas</option>
                @if (Model?.CeldasDisponibles != null)
                {
                    @foreach (var c in Model.CeldasDisponibles)
                    {
                        <option value="@c" selected="@(Model?.FiltroCelda == c)">@c</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Turno</label>
            <select name="turno">
                <option value="Todos" selected="@(string.IsNullOrEmpty(Model?.FiltroTurno) || Model?.FiltroTurno == "Todos")">Todos</option>
                @if (Model?.TurnosDisponibles != null)
                {
                    @foreach (var t in Model.TurnosDisponibles)
                    {
                        <option value="@t" selected="@(Model?.FiltroTurno == t)">@t</option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
        <a asp-action="Index" class="btn btn-secondary btn-sm" style="text-decoration:none;display:inline-flex;align-items:center;">Limpiar</a>
    </form>
</div>

<!-- GRID DEL CALENDARIO SEGÚN GRANULARIDAD -->
<div class="card" style="padding:12px">
    @if (granularidad == "diario")
    {
        <!-- VISTA DIARIA -->
        <div class="cal-grid-diario">
            <div class="cal-cell today">
                <div class="cal-day-num" style="font-size:14px;margin-bottom:12px;">
                    <span>@fechaBase.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-MX")).ToUpper()</span>
                    <span class="badge badge-programado">@((Model?.Eventos?.Count ?? 0)) Registros</span>
                </div>

                @if (Model?.Eventos != null && Model.Eventos.Any())
                {
                    @foreach (var ev in Model.Eventos)
                    {
                        string turnoUpper = (ev.TurnoClave ?? "").ToUpperInvariant();
                        string claseTurno = "turno-matutino";
                        if (turnoUpper.Contains("2") || turnoUpper.Contains("VESP")) claseTurno = "turno-vespertino";
                        else if (turnoUpper.Contains("3") || turnoUpper.Contains("NOCT")) claseTurno = "turno-nocturno";
                        else if (turnoUpper.Contains("12H")) claseTurno = "turno-12h";

                        string estatusLower = (ev.Estado ?? "pendiente").ToLowerInvariant();
                        string claseEstado = estatusLower switch
                        {
                            "terminado" or "completado" => "estado-terminado",
                            "activo" or "en proceso" or "en curso" => "estado-activo",
                            _ => "estado-pendiente"
                        };
                        string badgeEstadoClass = estatusLower switch
                        {
                            "terminado" or "completado" => "badge-estado-terminado",
                            "activo" or "en proceso" or "en curso" => "badge-estado-activo",
                            _ => "badge-estado-pendiente"
                        };

                        <div class="card-evento @claseTurno @claseEstado" style="padding:10px; margin-bottom:8px; cursor:pointer;"
                             onclick="abrirModalParos(@ev.Id, '@ev.ProyectoCodigo', '@ev.LineaNombre', '@ev.CeldaCodigo', @ev.Horas, '@ev.SapPartNumber', '@ev.Descripcion')">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <strong style="font-size:13px; color:var(--text);">@ev.ProyectoCodigo</strong>
                                <span class="badge-estado @badgeEstadoClass">@(ev.Estado ?? "Pendiente")</span>
                            </div>
                            
                            <!-- NÚMERO DE CLIENTE Y DESCRIPCIÓN CLARAMENTE SEPARADOS -->
                            <div style="font-size:11px; margin:4px 0; color:var(--text);">
                                <span style="font-weight:700; color:var(--text-muted);">No. de Cliente:</span> 
                                <span style="font-weight:700; color:var(--accent);">@ev.SapPartNumber</span>
                            </div>
                            <div style="font-size:10px; margin-bottom:4px; color:var(--text);">
                                <span style="font-weight:700; color:var(--text-muted);">Descripción:</span> 
                                <span>@(ev.Descripcion ?? "Sin descripción")</span>
                            </div>
                            <div style="font-size:10px; color:var(--text-muted);">@ev.LineaNombre / @ev.CeldaCodigo</div>

                            @if (ev.TieneParosTemporales)
                            {
                                <div style="margin-top:3px;">
                                    <span style="background:#fef3c7; color:#d97706; font-size:9.5px; font-weight:700; padding:1px 6px; border-radius:4px; display:inline-block;">
                                        🟠 Paro Temporal
                                    </span>
                                </div>
                            }

                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px;">
                                <div style="display:flex; gap:6px; align-items:center;">
                                    <span style="font-size:11px; font-weight:700; color:var(--text);">@ev.TurnoClave</span>
                                    <span class="horas-pill">@ev.Horas h</span>
                                </div>
                                <div style="font-size:11.5px; font-weight:700; color:var(--text);">
                                    📦 @ev.Cantidad.ToString("N0") pzas
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding:20px;text-align:center;color:var(--text-muted);">No hay eventos programados para este día.</div>
                }
            </div>
        </div>
    }
    else if (granularidad == "semanal")
    {
        <!-- VISTA SEMANAL -->
        <div class="cal-header">
            @for (int s = 0; s < 7; s++)
            {
                <div>@fechaBase.AddDays(s).ToString("ddd dd", new System.Globalization.CultureInfo("es-MX"))</div>
            }
        </div>
        <div class="cal-grid-semanal">
            @for (int s = 0; s < 7; s++)
            {
                var diaSemana = fechaBase.AddDays(s);
                var eventosSemana = Model?.Eventos?.Where(e => e.Fecha.Date == diaSemana.Date).ToList() ?? new();

                <div class="cal-cell @(diaSemana.Date == DateTime.Today ? "today" : "")">
                    <div class="cal-day-num">@diaSemana.ToString("dd MMM")</div>
                    @foreach (var ev in eventosSemana)
                    {
                        string turnoUpper = (ev.TurnoClave ?? "").ToUpperInvariant();
                        string claseTurno = "turno-matutino";
                        if (turnoUpper.Contains("2") || turnoUpper.Contains("VESP")) claseTurno = "turno-vespertino";
                        else if (turnoUpper.Contains("3") || turnoUpper.Contains("NOCT")) claseTurno = "turno-nocturno";
                        else if (turnoUpper.Contains("12H")) claseTurno = "turno-12h";

                        string estatusLower = (ev.Estado ?? "pendiente").ToLowerInvariant();
                        string claseEstado = estatusLower switch
                        {
                            "terminado" or "completado" => "estado-terminado",
                            "activo" or "en proceso" or "en curso" => "estado-activo",
                            _ => "estado-pendiente"
                        };
                        string badgeEstadoClass = estatusLower switch
                        {
                            "terminado" or "completado" => "badge-estado-terminado",
                            "activo" or "en proceso" or "en curso" => "badge-estado-activo",
                            _ => "badge-estado-pendiente"
                        };

                        <div class="card-evento @claseTurno @claseEstado" style="cursor:pointer;"
                             onclick="abrirModalParos(@ev.Id, '@ev.ProyectoCodigo', '@ev.LineaNombre', '@ev.CeldaCodigo', @ev.Horas, '@ev.SapPartNumber', '@ev.Descripcion')">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <strong style="font-size:11px; color:var(--text);">@ev.ProyectoCodigo</strong>
                                <span class="badge-estado @badgeEstadoClass">@(ev.Estado ?? "Pendiente")</span>
                            </div>
                            <div style="font-size:10px; margin:2px 0; color:var(--text);">
                                <span style="font-weight:700; color:var(--text-muted);">Cliente:</span> 
                                <span style="color:var(--accent); font-weight:600;">@ev.SapPartNumber</span>
                            </div>
                            <div style="font-size:9.5px; color:var(--text);">
                                <span style="font-weight:700; color:var(--text-muted);">Desc:</span> 
                                <span>@(ev.Descripcion ?? "N/A")</span>
                            </div>
                            <div style="font-size:9px; color:var(--text-muted);">@ev.LineaNombre / @ev.CeldaCodigo</div>

                            @if (ev.TieneParosTemporales)
                            {
                                <div style="margin-top:3px;">
                                    <span style="background:#fef3c7; color:#d97706; font-size:9.5px; font-weight:700; padding:1px 6px; border-radius:4px; display:inline-block;">
                                        🟠 Paro Temporal
                                    </span>
                                </div>
                            }

                            <div style="margin-top:3px; display:flex; justify-content:space-between; align-items:center;">
                                <span style="font-size:9px; font-weight:700; color:var(--text);">@ev.TurnoClave</span>
                                <span class="horas-pill">@ev.Horas h</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <!-- VISTA MENSUAL -->
        <div class="cal-header">
            <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div><div>Dom</div>
        </div>
        <div class="cal-grid">
            @for (int i = totalCeldasPrevias; i >= 1; i--)
            {
                int numDiaPrevio = diasMesAnterior - i + 1;
                <div class="cal-cell other-month">
                    <div class="cal-day-num">@numDiaPrevio</div>
                </div>
            }

            @for (int dia = 1; dia <= diasEnMes; dia++)
            {
                var fechaActual = new DateTime(primerDiaMes.Year, primerDiaMes.Month, dia);
                var eventosDelDia = Model?.Eventos?.Where(e => e.Fecha.Date == fechaActual.Date).ToList() ?? new();

                <div class="cal-cell @(fechaActual.Date == DateTime.Today ? "today" : "")">
                    <div class="cal-day-num">@dia</div>
                    @if (eventosDelDia.Any())
                    {
                        @foreach (var ev in eventosDelDia)
                        {
                            string turnoUpper = (ev.TurnoClave ?? "").ToUpperInvariant();
                            string claseTurno = "turno-matutino";
                            if (turnoUpper.Contains("2") || turnoUpper.Contains("VESP")) claseTurno = "turno-vespertino";
                            else if (turnoUpper.Contains("3") || turnoUpper.Contains("NOCT")) claseTurno = "turno-nocturno";
                            else if (turnoUpper.Contains("12H")) claseTurno = "turno-12h";

                            string estatusLower = (ev.Estado ?? "pendiente").ToLowerInvariant();
                            string claseEstado = estatusLower switch
                            {
                                "terminado" or "completado" => "estado-terminado",
                                "activo" or "en proceso" or "en curso" => "estado-activo",
                                _ => "estado-pendiente"
                            };
                            string badgeEstadoClass = estatusLower switch
                            {
                                "terminado" or "completado" => "badge-estado-terminado",
                                "activo" or "en proceso" or "en curso" => "badge-estado-activo",
                                _ => "badge-estado-pendiente"
                            };

                            <div class="card-evento @claseTurno @claseEstado" style="cursor:pointer;"
                                 onclick="abrirModalParos(@ev.Id, '@ev.ProyectoCodigo', '@ev.LineaNombre', '@ev.CeldaCodigo', @ev.Horas, '@ev.SapPartNumber', '@ev.Descripcion')">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <strong style="font-size:11px; color:var(--text);">@ev.ProyectoCodigo</strong>
                                    <span class="badge-estado @badgeEstadoClass">@(ev.Estado ?? "Pendiente")</span>
                                </div>
                                <div style="font-size:10px; margin:2px 0; color:var(--text);">
                                    <span style="font-weight:700; color:var(--text-muted);">Cliente:</span> 
                                    <span style="color:var(--accent); font-weight:600;">@ev.SapPartNumber</span>
                                </div>
                                <div style="font-size:9.5px; color:var(--text);">
                                    <span style="font-weight:700; color:var(--text-muted);">Desc:</span> 
                                    <span>@(ev.Descripcion ?? "N/A")</span>
                                </div>
                                <div style="font-size:9px; color:var(--text-muted);">@ev.LineaNombre / @ev.CeldaCodigo</div>

                                @if (ev.TieneParosTemporales)
                                {
                                    <div style="margin-top:3px;">
                                        <span style="background:#fef3c7; color:#d97706; font-size:9.5px; font-weight:700; padding:1px 6px; border-radius:4px; display:inline-block;">
                                            🟠 Paro Temporal
                                        </span>
                                    </div>
                                }

                                <div style="margin-top:3px; display:flex; justify-content:space-between; align-items:center;">
                                    <span style="font-size:9px; font-weight:700; color:var(--text);">@ev.TurnoClave</span>
                                    <span class="horas-pill">@ev.Horas h</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            @{
                int totalCeldasActuales = totalCeldasPrevias + diasEnMes;
                int celdasRestantes = (7 - (totalCeldasActuales % 7)) % 7;
            }
            @for (int j = 1; j <= celdasRestantes; j++)
            {
                <div class="cal-cell other-month">
                    <div class="cal-day-num">@j</div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL DE DETALLE Y GESTIÓN DE PAROS DEL PROYECTO -->
<div id="modalParosOverlay"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:300; align-items:center; justify-content:center; padding:16px;">
    <div style="background:var(--surface); border-radius:12px; padding:24px; width:100%; max-width:580px; max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,0.25);">

        <!-- Cabecera del Modal -->
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
    <div>
        <h3 id="modalProgTitulo" style="font-size:16px; font-weight:700; margin:0; color:var(--text);">
            Paros / Incidencias
        </h3>
        <!-- NUEVO CONTENEDOR ESTRUCTURADO CON ETIQUETAS -->
        <div id="modalProgSubtitulo" style="font-size:11.5px; color:var(--text-muted); margin-top:4px; line-height:1.4;">
            <!-- Dinámico desde JS -->
        </div>
    </div>
    <button type="button" onclick="cerrarModalParos()" style="background:none; border:none; font-size:20px; cursor:pointer; color:var(--text-muted);">&times;</button>
</div>

        @if (soloLectura)
        {
            <div style="background:#fffbeb; border:1px solid #fde68a; color:#92400e; padding:8px 12px; border-radius:6px; font-size:12px; margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <span>🔒 <strong>Modo Consulta (Solo Lectura):</strong> Perteneces a la Planta @plantaAsignadaId. No tienes permisos para registrar o editar incidencias en esta planta.</span>
            </div>
        }

        <!-- Ficha Resumen de la Corrida -->
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px; margin-bottom:16px; background:var(--surface2); padding:12px; border-radius:8px;">
            <div>
                <span style="font-size:10px; color:var(--text-muted); font-weight:700; display:block;">HORAS TURNO</span>
                <div id="lblModalHorasProg" style="font-size:15px; font-weight:800; color:var(--text);">0.00 h</div>
            </div>
            <div>
                <span style="font-size:10px; color:var(--warning); font-weight:700; display:block;">TOTAL PAROS</span>
                <div id="lblModalTotalParos" style="font-size:15px; font-weight:800; color:var(--warning);">0 min</div>
            </div>
            <div>
                <span style="font-size:10px; color:var(--success); font-weight:700; display:block;">TIEMPO EFECTIVO</span>
                <div id="lblModalTiempoNeto" style="font-size:15px; font-weight:800; color:var(--success);">0.00 h</div>
            </div>
        </div>

        <form id="formParosProyecto" onsubmit="guardarParosProyecto(event)">
            <input type="hidden" id="modalProgId" name="programacionId" value="0" />

            <!-- Tabla Dinámica de Paros -->
            <div style="margin-bottom:16px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text-muted); margin:0;">INCIDENCIAS / PAROS REGISTRADOS</label>
                </div>

                <div class="table-wrap">
                    <table style="font-size:12px;">
                        <thead>
                            <tr style="background:var(--surface2);">
                                <th>Motivo / Razón</th>
                                <th style="width:110px;">Duración (min)</th>
                                <th style="width:120px;">Tipo</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="listaParosProyectoBody">
                            <!-- Filas dinámicas -->
                        </tbody>
                    </table>
                </div>

                <div id="alertaExcesoModal" style="display:none; color:var(--danger); font-size:11.5px; font-weight:700; margin-top:8px;">
                    ⚠ Los paros no pueden superar el tiempo total programado del turno.
                </div>
            </div>

            <!-- Botones de Acción -->
            <div style="display:flex; justify-content:flex-end; gap:8px; border-top:1px solid var(--border); padding-top:14px;">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalParos()">Cerrar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const esSoloLectura = @(soloLectura ? "true" : "false");
        let indexParoProg = 0;
        let horasProgActuales = 0;

        document.addEventListener('DOMContentLoaded', () => {
            const selFiltroLinea = document.getElementById('filtroLineaCalendario');
            const selFiltroCelda = document.getElementById('filtroCeldaCalendario');
            const celdaSeleccionadaActual = '@(Model?.FiltroCelda ?? "Todas")';

            async function filtrarCeldasPorLinea(lineaValor, mantenerSeleccion = false) {
                if (!selFiltroCelda) return;

                const celdaActual = mantenerSeleccion ? selFiltroCelda.value : celdaSeleccionadaActual;
                selFiltroCelda.innerHTML = '<option value="Todas">Todas</option>';

                try {
                    let url = '';
                    if (!lineaValor || lineaValor === "Todas" || lineaValor === "0") {
                        url = `/Calendario/ObtenerTodasCeldasPlanta`;
                    } else {
                        url = `/Calendario/ObtenerCeldasPorLineaNombre?lineaNombre=${encodeURIComponent(lineaValor)}`;
                    }

                    const resp = await fetch(url);
                    if (resp.ok) {
                        const celdas = await resp.json();
                        if (celdas && celdas.length > 0) {
                            celdas.forEach(item => {
                                const codigoCelda = item.texto || item.Texto;
                                const isSelected = (codigoCelda === celdaActual) ? 'selected' : '';
                                selFiltroCelda.innerHTML += `<option value="${codigoCelda}" ${isSelected}>${codigoCelda}</option>`;
                            });
                        }
                    }
                } catch (err) {
                    console.error("Error al filtrar celdas en el calendario:", err);
                }
            }

            if (selFiltroLinea) {
                selFiltroLinea.addEventListener('change', function () {
                    filtrarCeldasPorLinea(this.value, false);
                });

                if (selFiltroLinea.value && selFiltroLinea.value !== "Todas") {
                    filtrarCeldasPorLinea(selFiltroLinea.value, true);
                }
            }
        });

        function cerrarModalParos() {
            document.getElementById('modalParosOverlay').style.display = 'none';
        }

        function abrirModalParos(id, proyecto, linea, celda, horas, parte = '', descripcion = '') {
            document.getElementById('modalProgId').value = id;
            
            // Título limpio
            let tituloModal = esSoloLectura ? 'Consulta de Paros' : 'Paros / Incidencias';
            document.getElementById('modalProgTitulo').innerText = `${tituloModal} — Proyecto: ${proyecto}`;
            
            // Subtítulo con enunciados claros y separados por líneas
            const subContainer = document.getElementById('modalProgSubtitulo');
            if (subContainer) {
                subContainer.innerHTML = `
                    <div><strong style="color:var(--text);">Cliente / Parte:</strong> ${parte || 'N/A'}</div>
                    <div><strong style="color:var(--text);">Descripción:</strong> ${descripcion || 'Sin descripción'}</div>
                    <div style="margin-top:2px; color:var(--text-muted);">${linea} / ${celda} — <strong>${horas} hrs planeadas</strong></div>
                `;
            }

            horasProgActuales = parseFloat(horas) || 0;
            document.getElementById('lblModalHorasProg').innerText = `${horasProgActuales.toFixed(2)} h`;

            const tbody = document.getElementById('listaParosProyectoBody');
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:10px; color:var(--text-muted);">Cargando paros...</td></tr>';
            document.getElementById('modalParosOverlay').style.display = 'flex';

            fetch(`/Calendario/ObtenerParosProgramacion?programacionId=${id}`)
                .then(r => r.json())
                .then(data => {
                    tbody.innerHTML = '';
                    indexParoProg = 0;

                    if (data && data.length > 0) {
                        data.forEach(p => {
                            let cat = p.categoriaParo !== undefined ? p.categoriaParo : 1;
                            let motivoReal = p.descripcion || p.tipoParo;
                            agregarFilaParoProyecto(motivoReal, p.duracionMinutos, cat, p.id);
                        });
                    } else {
                        tbody.innerHTML = `<tr id="filaSinParos"><td colspan="4" style="text-align:center; padding:12px; color:var(--text-muted); font-size:11.5px;">Sin paros registrados.</td></tr>`;
                    }
                    recalcularTiemposModal();
                })
                .catch(() => {
                    tbody.innerHTML = '<tr id="filaSinParos"><td colspan="4" style="text-align:center; padding:12px; color:var(--text-muted); font-size:11.5px;">Sin paros registrados.</td></tr>';
                    recalcularTiemposModal();
                });
        }

        function agregarFilaParoProyecto(motivo = '', minutos = 15, categoriaParo = 3, paroId = 0) {
            const tbody = document.getElementById('listaParosProyectoBody');
            const filaVacia = document.getElementById('filaSinParos');
            if (filaVacia) filaVacia.remove();

            const esHistorial = (paroId > 0);
            const desactivarTodo = esSoloLectura || esHistorial;

            const disabledAttr = desactivarTodo ? 'disabled' : '';
            const selectDisabledAttr = (desactivarTodo || paroId === 0) ? 'disabled' : '';

            const botonAccionHtml = !desactivarTodo 
                ? '<button type="button" class="btn btn-danger btn-sm" style="padding:2px 6px; font-size:11px;" onclick="eliminarFilaParoProyecto(this)" title="Eliminar">✕</button>' 
                : '<span style="font-size:10px; color:var(--text-muted);" title="Registrado en historial">🔒 Historial</span>';

            const cat = parseInt(categoriaParo, 10) || 3;

            let opcionesSelectHtml = '';
            if (paroId > 0) {
                opcionesSelectHtml = `
                    <option value="1" ${cat === 1 ? 'selected' : ''}>🔵 Base / Turno</option>
                    <option value="2" ${cat === 2 ? 'selected' : ''}>🟠 Temporal (Día)</option>
                    <option value="3" ${cat === 3 ? 'selected' : ''}>🔴 No Prog. (Falla)</option>
                `;
            } else {
                opcionesSelectHtml = `
                    <option value="3" selected>🔴 No Prog. (Falla)</option>
                `;
            }

            const tr = document.createElement('tr');
            tr.className = 'fila-paro-prog';
            tr.innerHTML = `
                <td>
                    <input type="hidden" class="p-id" value="${paroId}" />
                    <input type="text" class="form-control form-control-sm p-motivo" placeholder="Ej. Falla de máquina / Setup" value="${motivo}" required ${disabledAttr} style="padding:4px 8px; font-size:14px; width:100%;" />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm p-minutos" min="1" value="${minutos}" 
                           oninput="recalcularTiemposModal()" onchange="recalcularTiemposModal()" required ${disabledAttr} style="padding:4px 8px; font-size:12px; width:100%;" />
                </td>
                <td>
                    <select class="form-select form-select-sm p-categoria" ${selectDisabledAttr} style="padding:4px 8px; font-size:12px; width:120%;">
                        ${opcionesSelectHtml}
                    </select>
                </td>
                <td style="text-align:center;">
                    ${botonAccionHtml}
                </td>
            `;
            tbody.appendChild(tr);
            indexParoProg++;
            recalcularTiemposModal();
        }

        function eliminarFilaParoProyecto(btn) {
            if (esSoloLectura) return;
            btn.closest('tr').remove();
            recalcularTiemposModal();
        }

        function recalcularTiemposModal() {
            let horasBase = parseFloat(horasProgActuales) || 0;
            let minutosTotalesProg = Math.round(horasBase * 60);
            let totalParoMinutos = 0;

            document.querySelectorAll('.p-minutos').forEach(input => {
                let val = parseInt(input.value, 10);
                if (!isNaN(val) && val > 0) {
                    totalParoMinutos += val;
                }
            });

            let tiempoNetoMinutos = minutosTotalesProg - totalParoMinutos;
            let alerta = document.getElementById('alertaExcesoModal');
            let btnGuardar = document.getElementById('btnGuardarParosProg');
            let lblTiempo = document.getElementById('lblModalTiempoNeto');
            let lblParos = document.getElementById('lblModalTotalParos');

            if (lblParos) {
                lblParos.innerText = `${totalParoMinutos} min (${(totalParoMinutos / 60).toFixed(2)} h)`;
            }

            if (tiempoNetoMinutos < 0) {
                if (alerta) alerta.style.display = 'block';
                if (btnGuardar && !esSoloLectura) btnGuardar.disabled = true;
                if (lblTiempo) {
                    lblTiempo.style.color = 'var(--danger)';
                    lblTiempo.innerText = '0.00 h (Excedido)';
                }
            } else {
                if (alerta) alerta.style.display = 'none';
                if (btnGuardar && !esSoloLectura) btnGuardar.disabled = false;

                let horasDecimal = tiempoNetoMinutos / 60;
                let hEnteras = Math.floor(tiempoNetoMinutos / 60);
                let mRestantes = tiempoNetoMinutos % 60;

                if (lblTiempo) {
                    lblTiempo.style.color = 'var(--success)';
                    lblTiempo.innerText = `${horasDecimal.toFixed(2)} h (${hEnteras}h ${mRestantes}m)`;
                }
            }
        }

        function guardarParosProyecto(e) {
            e.preventDefault();

            if (esSoloLectura) {
                alert('Modo Solo Lectura: No tienes permisos para guardar paros en esta planta.');
                return;
            }

            const programacionId = document.getElementById('modalProgId').value;

            let paros = [];
            document.querySelectorAll('.fila-paro-prog').forEach(row => {
                let catVal = parseInt(row.querySelector('.p-categoria').value) || 1;
                paros.push({
                    id: parseInt(row.querySelector('.p-id').value) || 0,
                    programacionId: parseInt(programacionId),
                    tipoParo: row.querySelector('.p-motivo').value,
                    duracionMinutos: parseInt(row.querySelector('.p-minutos').value) || 0,
                    categoriaParo: catVal,
                    esProgramado: catVal !== 3
                });
            });

            fetch('/Calendario/GuardarParosProgramacion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ programacionId: parseInt(programacionId), paros: paros })
            })
            .then(r => {
                if (r.status === 403) {
                    throw new Error('Modo Solo Lectura: Acción rechazada para plantas foráneas.');
                }
                return r.json();
            })
            .then(res => {
                if (res.success) {
                    cerrarModalParos();
                    location.reload();
                } else {
                    alert(res.message || 'Error al guardar paros.');
                }
            })
            .catch(err => {
                alert(err.message || 'Ocurrió un error al procesar la solicitud.');
            });
        }
    </script>
}