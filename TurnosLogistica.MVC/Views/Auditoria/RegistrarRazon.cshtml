@{
    ViewData["Title"] = "Registrar Razón";
    ViewData["Subtitle"] = "Bitácora inmutable para auditoría";
}

<div style="max-width: 540px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px;">
    <div style="background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.25); border-radius:var(--radius); padding:10px 14px; font-size:12px; color:#fcd34d; margin-bottom:14px; font-family:var(--font-mono);">
        Toda cancelación o modificación debe llevar una razón registrada. Este registro no puede alterarse posteriormente.
    </div>

    <form asp-action="GuardarRazon" method="post">
        <div style="margin-bottom:14px;">
            <label style="display:block; font-size:11px; font-family:var(--font-mono); color:var(--text-muted); margin-bottom:6px;">OT / AGENDA RELACIONADA *</label>
            <input type="text" name="otId" class="search-input" style="width:100%;" placeholder="Ej. OT-2026-08-042" required />
        </div>

        <div style="margin-bottom:14px;">
            <label style="display:block; font-size:11px; font-family:var(--font-mono); color:var(--text-muted); margin-bottom:6px;">TIPO DE EVENTO *</label>
            <select name="tipoEvento" class="filter-select" style="width:100%;">
                <option>Cancelación de OT</option>
                <option>Modificación de Fecha</option>
                <option>Cambio de Turno</option>
            </select>
        </div>

        <div style="margin-bottom:14px;">
            <label style="display:block; font-size:11px; font-family:var(--font-mono); color:var(--text-muted); margin-bottom:6px;">RAZÓN DETALLADA *</label>
            <textarea name="motivo" class="search-input" style="width:100%; height:80px;" placeholder="Detalle la falla de troquel, retraso o motivo de reprogramación..." required></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:20px;">
            <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary">Registrar y Guardar</button>
        </div>
    </form>
</div>