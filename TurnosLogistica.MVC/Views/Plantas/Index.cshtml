@{
    ViewData["Title"] = "Selector de Planta";
}

<div class="page-header">
    <div>
        <div class="page-title">Selector de Planta</div>
        <div class="page-subtitle">Elija la planta de trabajo activa para esta sesión</div>
    </div>
</div>

<div class="notice notice-info" style="margin-bottom:24px">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;margin-top:1px"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
    <span><strong>Sistema multi-planta:</strong> El sistema es multi-planta y funciona sin modificar el código. Cada planta mantiene su propia estructura de Proyecto → Línea → Celda → Estación y catálogo de partes.</span>
</div>

<div class="card" style="max-width:680px">
    <div class="card-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent)"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
        Plantas registradas
    </div>
    <div class="planta-grid">
        <div class="planta-card selected">
            <div class="pc-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--accent)"><path d="M4 10v7h3v-7H4zm6.5 0v7h3v-7h-3zM2 22h19v-3H2v3zm15-12v7h3v-7h-3zM11.5 1L2 6v2h19V6z"/></svg>
            </div>
            <h3>Planta 1</h3>
            <p>Monterrey, N.L.</p>
            <p style="margin-top:8px;font-size:11px;color:var(--success);font-weight:700">ACTIVA</p>
        </div>
        <div class="planta-card">
            <div class="pc-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--accent)"><path d="M4 10v7h3v-7H4zm6.5 0v7h3v-7h-3zM2 22h19v-3H2v3zm15-12v7h3v-7h-3zM11.5 1L2 6v2h19V6z"/></svg>
            </div>
            <h3>Planta 2</h3>
            <p>Saltillo, Coah.</p>
            <p style="margin-top:8px;font-size:11px;color:var(--success);font-weight:700">ACTIVA</p>
        </div>
        <div class="planta-card">
            <div class="pc-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--accent)"><path d="M4 10v7h3v-7H4zm6.5 0v7h3v-7h-3zM2 22h19v-3H2v3zm15-12v7h3v-7h-3zM11.5 1L2 6v2h19V6z"/></svg>
            </div>
            <h3>Planta 3</h3>
            <p>San Luis Potosí</p>
            <p style="margin-top:8px;font-size:11px;color:var(--text-muted);font-weight:600">CONFIGURACIÓN</p>
        </div>
    </div>
</div>