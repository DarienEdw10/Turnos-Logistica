@{
    ViewData["Title"] = "Inicio";

    // 1. Obtener datos del usuario desde los Claims
    string nombreUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    string rolUsuario = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "operador").ToUpper();

    int nivel = 10;
    if (int.TryParse(User.FindFirst("NivelJerarquico")?.Value, out int nVal))
    {
        nivel = nVal;
    }

    int plantaAsignadaId = 1;
    if (int.TryParse(User.FindFirst("PlantaAsignadaId")?.Value, out int pVal))
    {
        plantaAsignadaId = pVal;
    }

    int plantaActivaId = plantaAsignadaId;
    if (Context.Request.Cookies.TryGetValue("PlantaActivaId", out string? cVal) && int.TryParse(cVal, out int cParsed))
    {
        plantaActivaId = cParsed;
    }

    bool esPlantaForanea = (plantaActivaId != plantaAsignadaId);
    bool esSistemas = (nivel >= 40 || rolUsuario == "SISTEMAS");
}

<div class="page-header" style="margin-bottom: 24px;">
    <div>
        <div class="page-title" style="font-size: 22px; font-weight: 700;">Bienvenido, @nombreUsuario</div>
        <div class="page-subtitle" style="color: var(--text-muted); font-size: 14px;">
            Sistema de Programación de Producción — Planta Base: <strong>Planta @plantaAsignadaId</strong> | Visualizando: <strong>Planta @plantaActivaId</strong>
        </div>
    </div>
</div>

<!-- PANEL DE ACCESOS RÁPIDOS -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">

    <!-- Card: Calendario -->
    <a asp-controller="Calendario" asp-action="Index" class="card" style="text-decoration: none; padding: 20px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
            <div style="width: 38px; height: 38px; border-radius: 8px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2h-1V1h-2zm3 18H5V8h14v11z"/>
                </svg>
            </div>
            <div>
                <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text);">Calendario</h4>
                <span style="font-size: 11.5px; color: var(--text-muted);">Agenda de turnos</span>
            </div>
        </div>
        <p style="margin: 0; font-size: 12px; color: var(--text-muted);">Consulta y visualiza las órdenes de producción programadas por día, semana o mes.</p>
    </a>

    <!-- Card: Programación -->
    @if (nivel >= 20)
    {
        <a asp-controller="Programacion" asp-action="Index" class="card" style="text-decoration: none; padding: 20px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
                <div style="width: 38px; height: 38px; border-radius: 8px; background: #f0fdf4; color: #16a34a; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                    </svg>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text);">Programación</h4>
                    <span style="font-size: 11.5px; color: var(--text-muted);">Asignación operativa</span>
                </div>
            </div>
            <p style="margin: 0; font-size: 12px; color: var(--text-muted);">Captura órdenes de trabajo individuales o balanceos masivos por WorkCenter.</p>
        </a>
    }

    <!-- Card: Rendimiento Turno -->
    <a asp-controller="Rendimiento" asp-action="Index" class="card" style="text-decoration: none; padding: 20px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
            <div style="width: 38px; height: 38px; border-radius: 8px; background: #faf5ff; color: #9333ea; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
            </div>
            <div>
                <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text);">Rendimiento</h4>
                <span style="font-size: 11.5px; color: var(--text-muted);">Cierre de piso</span>
            </div>
        </div>
        <p style="margin: 0; font-size: 12px; color: var(--text-muted);">Control de piezas terminadas, tiempos efectivos y reporte de incidencias/paros.</p>
    </a>

    <!-- Card: Auditoría (Nivel >= 30) -->
    @if (nivel >= 30)
    {
        <a asp-controller="Auditoria" asp-action="Index" class="card" style="text-decoration: none; padding: 20px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
                <div style="width: 38px; height: 38px; border-radius: 8px; background: #fff7ed; color: #ea580c; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M13 9h-2V7h2m0 10h-2v-6h2m-1-9A10 10 0 002 12a10 10 0 0010 10 10 10 0 0010-10A10 10 0 0012 2z"/>
                    </svg>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text);">Auditoría</h4>
                    <span style="font-size: 11.5px; color: var(--text-muted);">Trazabilidad inmutable</span>
                </div>
            </div>
            <p style="margin: 0; font-size: 12px; color: var(--text-muted);">Historial forense de creaciones, reprogramaciones e intervenciones técnicas.</p>
        </a>
    }
</div>